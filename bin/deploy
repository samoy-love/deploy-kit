#!/usr/bin/env bash
# Локальная выкатка — то же самое, что делает CI, но со своей машины.
#
#   deploy --config .deploy-kit/prod.env            # собрать и выкатить
#   deploy --config .deploy-kit/prod.env --dry-run  # показать план
#   deploy --config .deploy-kit/prod.env --no-build # выкатить уже собранное
#   deploy --config .deploy-kit/prod.env --allow-unpushed  # коммита нет на remote
#   deploy --config … --allow-same-version          # осознанный повтор версии
#   deploy --config … --verbose                     # показать вывод сборки
#
# По умолчанию вывод сборщика уезжает в файл и печатается только при провале:
# он занимал девять десятых вывода при выкатке всех целей. --verbose (или
# DK_VERBOSE=1) возвращает его на экран.
#
# Принципиально: CI и этот скрипт читают ОДИН и тот же файл-описание проекта
# и вызывают ОДИН и тот же release.sh на сервере. Иначе «локально катится, а
# в CI нет» — вопрос времени.
#
# Файл-описание (.deploy-kit/prod.env в репозитории проекта):
#
#   APP=samoylove                  имя приложения (каталог на сервере)
#   BUILD_CMD="npm ci && npm run build"
#   ARTIFACT_DIR=dist              что паковать
#   ROOT=/var/www/samoy.love       корень с releases/ и current
#   OWNER=ubuntu:ubuntu            владелец файлов релиза
#   NGINX_CONF=nginx/sites/metro.conf   конфиг сайта — путь ВНУТРИ deploy-kit
#   NGINX_DEST=/etc/nginx/sites-available/metro.conf   куда его ставить
#   NGINX_RELOAD=1                 перезагрузить nginx после переключения
#   UNIT=                          systemd-юнит для сервисов
#   HEALTH=https://samoy.love/
#   VERSION_URL=https://samoy.love/version.json
#   NEIGHBOURS=metro.samoy.love,snakes.samoy.love
#   LINK_BASE=https://github.com/tr0llex/deploy-kit   база ссылок на PR в
#                                  списке изменений. Пусто — вывести из
#                                  `git remote get-url origin`; none — не
#                                  ставить ссылок вовсе.
#
# Цель-файл (установщик): вместо ARTIFACT_DIR/ROOT — публикация одного файла
# через publish-file.sh, см. .deploy-kit/installer.env у chillhub:
#
#   ARTIFACT_FILE=scripts/generated_downloads/ChillHub-Setup.exe
#   PUBLISH_DEST=/var/www/site-downloads/ChillHub-Setup.exe
#   VERSION_CMD="sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' …"  версия сборки
#   VERIFY_URL=https://…/ChillHub-Setup.exe.sha256    сверка суммы с прода
#   SELFUPDATE_URL=https://…/admin/api                админ-API лаунчера: ZIP
#   SELFUPDATE_ZIP=scripts/…/ChillHub-launcher-payload.zip   самообновления
#                                  уезжает туда через bin/selfupdate-upload;
#                                  latest.json НЕ переключается — активной
#                                  версию делает человек в админке
#
# Список изменений уходит в чат ЦЕЛИКОМ. Не влезает в одно сообщение Telegram —
# уезжает несколькими подряд, а не режется: см. notify() ниже.
#
# Хост, ключ и токен чата берутся из ~/.config/deploy-kit/dk.conf (путь
# переопределяется через DK_CONF), из окружения или из самого файла-описания:
#   DEPLOY_HOST, DEPLOY_USER, DEPLOY_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# Для цели с SELFUPDATE_URL там же живут ADMIN_USER и ADMIN_PASSWORD.
# Окружение сильнее dk.conf, а описание цели — сильнее обоих.

set -Eeuo pipefail

# Корень deploy-kit. Отсюда берутся конфиги nginx: они живут ТОЛЬКО здесь, в
# репозиториях проектов копий нет (иначе два источника правды разъезжаются, и
# какой из них на проде — выясняется по факту).
KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'
[[ -t 1 ]] || { RED=''; GRN=''; YEL=''; DIM=''; RST=''; }

# Время по Москве — БЕЗ опоры на базу зон.
#
# Раньше здесь стояло `TZ=Europe/Moscow date`. На ubuntu-раннере это работает,
# а в Git Bash на Windows базы /usr/share/zoneinfo нет, и неизвестное имя зоны
# молча трактуется как UTC — то есть метка получалась на три часа в прошлом.
# Ломалось это не в печати времени, а в версии релиза: `manual-<дата>` выходил
# СТАРШЕ уже выкаченного пайплайном `release-<дата>`, и версионный шлюз
# отказывал локальной выкатке (код 3) на каждой цели, выкаченной за последние
# три часа. Симптом при этом выглядел как «шлюз сломался», а не «часы врут».
#
# Москва с 2014 года — постоянный UTC+3 без перехода на летнее время, поэтому
# смещение считается арифметикой и совпадает с зоной по определению.
msk() { date -u -d '+3 hours' "+$1" 2>/dev/null || date -u -v+3H "+$1"; }

log()  { printf '%s[%s]%s %s\n' "$DIM" "$(msk '%H:%M:%S')" "$RST" "$*"; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$RST" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

CONFIG=""; DRY=0; BUILD=1; ALLOW_SAME=0; ALLOW_UNPUSHED=0
VERBOSE="${DK_VERBOSE:-0}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config)   CONFIG="$2"; shift 2 ;;
        --dry-run)  DRY=1; shift ;;
        --no-build) BUILD=0; shift ;;
        --allow-same-version) ALLOW_SAME=1; shift ;;
        --allow-unpushed) ALLOW_UNPUSHED=1; shift ;;
        -v|--verbose) VERBOSE=1; shift ;;
        # Диапазон совпадает с шапкой файла: правите шапку — правите число.
        # Раньше здесь стояло 30, и справка обрывалась посреди списка ключей
        # описания цели — ровно на том месте, ради которого её и открывают.
        -h|--help)  sed -n '2,58p' "$0"; exit 0 ;;
        *) die "неизвестный аргумент: $1" ;;
    esac
done
[[ -n "$CONFIG" ]] || die "нужен --config (например .deploy-kit/prod.env)"
[[ -f "$CONFIG" ]] || die "файл описания не найден: $CONFIG"

# Репозиторий проекта — тот, внутри которого лежит описание цели.
#
# Считается ОТ пути --config, а не от текущего каталога. Раньше список
# изменений брался из `.`, и это было верно ровно по случайности: `dk deploy`
# перед вызовом делает (cd "$dir" && bin/deploy …). Любой другой способ
# запуска — `bin/deploy --config ~/src/metro/.deploy-kit/prod.env` из дома, из
# git-хука, из чужого скрипта — приклеивал к сообщению о релизе коммиты того
# репозитория, в котором СТОЯЛ человек. Заметить это нечем: сообщение
# приходит, список непустой, просто он про другой проект.
#
# Описание цели по соглашению лежит в .deploy-kit/ репозитория проекта,
# поэтому корень выводится из него однозначно. Не git-репозиторий — не беда:
# тогда берётся каталог описания, и changelog сам скажет в stderr «не
# git-репозиторий», а в stdout промолчит.
PROJECT_REPO="$(cd "$(dirname -- "$CONFIG")" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$PROJECT_REPO" ]] || PROJECT_REPO="$(cd "$(dirname -- "$CONFIG")" 2>/dev/null && pwd || printf '.')"

# --- настройки машины (dk.conf) -------------------------------------------
#
# Тот же файл и тот же порядок, что у bin/dk: реальное окружение сильнее файла,
# путь переопределяется через DK_CONF, по умолчанию ~/.config/deploy-kit/dk.conf.
#
# Читать его обязан сам bin/deploy, а не только bin/dk. Раньше dk.conf доезжал
# сюда исключительно как экспортированное окружение от `dk deploy`, и любой
# другой способ запуска (руками, из другого скрипта, из хука) оставлял
# TELEGRAM_* пустыми — уведомление молча не отправлялось.
#
# Файл читается ДО описания цели: настройки цели из --config обязаны быть
# сильнее машинных, иначе общий dk.conf переопределял бы NOTIFY или HEALTH
# конкретной цели. Отсутствие файла — норма (так живёт CI, где переменные
# приходят из секретов), поэтому его нет — молча идём дальше.
DK_CONF_FILE="${DK_CONF:-$HOME/.config/deploy-kit/dk.conf}"
dk_conf_load() {
    [[ -f "$DK_CONF_FILE" ]] || return 0
    # Имена служебных переменных начинаются с _dk_: сюда приезжают ЧУЖИЕ имена
    # из файла, и переменная цикла, названная line или name, была бы перезаписана
    # первой же строкой `name=…` в dk.conf.
    local _dk_line _dk_name
    # Файл читается в подоболочке, а в основной скрипт переносятся только те
    # переменные, которых в окружении ещё нет. Прямой `source` здесь был бы
    # ошибкой: он молча перебивал бы значения, заданные в окружении явно
    # (в CI — из секретов, на машине — из `VAR=… deploy …`).
    while IFS= read -r -d '' _dk_line; do
        _dk_name="${_dk_line%%=*}"
        [[ "$_dk_name" == "$_dk_line" ]] && continue
        [[ "$_dk_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        [[ "$_dk_name" == _dk_* ]] && continue
        [[ -n "${!_dk_name:-}" ]] && continue
        printf -v "$_dk_name" '%s' "${_dk_line#*=}" 2>/dev/null || continue
        export "${_dk_name?}" 2>/dev/null || true
    done < <(
        # Подоболочка одноразовая: чужой синтаксис в dk.conf не должен ронять
        # выкатку, поэтому здесь ни set -e, ни set -u.
        set +eu
        set -a
        # shellcheck disable=SC1090
        . "$DK_CONF_FILE" >/dev/null 2>&1
        set +a
        while IFS= read -r _dk_name; do
            printf '%s=%s\0' "$_dk_name" "${!_dk_name}"
        done < <(compgen -e)
    )
    return 0
}
dk_conf_load

# shellcheck disable=SC1090
source "$CONFIG"

: "${APP:?в описании нет APP}"

# Цели бывают двух форм, и различает их PUBLISH_DEST.
#
# Обычная цель — каталог-артефакт, который едет релизом: releases/, симлинк
# current, version.json, release.sh. Цель-файл (установщик лаунчера) в эту
# механику не помещается сознательно: один файл на четверть гигабайта живёт
# вне релизов сайта и «выкатить» его значит атомарно подменить — это делает
# publish-file.sh на сервере, тот же скрипт, которым публикует пайплайн
# (desktop-artifact.yml читает ЭТО ЖЕ описание через вход config).
#
# У цели-файла: ARTIFACT_FILE (что публиковать), PUBLISH_DEST (куда),
# VERSION_CMD (кто объявляет версию — например, <Version> из csproj),
# VERIFY_URL (сверка суммы с прода после публикации), HEALTH (ссылка
# «открыть» в уведомлении). ROOT, UNIT, KEEP и version.json к ней не
# применимы и в описании не задаются.
PUBLISH_MODE=0
if [[ -n "${PUBLISH_DEST:-}" ]]; then
    PUBLISH_MODE=1
    : "${ARTIFACT_FILE:?у цели с PUBLISH_DEST в описании нет ARTIFACT_FILE}"
    [[ "$PUBLISH_DEST" == /* ]] || die "PUBLISH_DEST должен быть абсолютным путём, получено: $PUBLISH_DEST"
else
    : "${ARTIFACT_DIR:?в описании нет ARTIFACT_DIR}"
    : "${ROOT:?в описании нет ROOT}"
fi
DEPLOY_HOST="${DEPLOY_HOST:?нет DEPLOY_HOST}"
DEPLOY_USER="${DEPLOY_USER:-ubuntu}"
DEPLOY_KEY="${DEPLOY_KEY:-$HOME/.ssh/id_ed25519}"
KEEP="${KEEP:-5}"

SSH=(ssh -i "$DEPLOY_KEY" -o StrictHostKeyChecking=yes "$DEPLOY_USER@$DEPLOY_HOST")
# -q гасит полосу прогресса. Она рисуется в терминал управляющими символами и
# в общем выводе выкатки одиннадцати целей оставляет одиннадцать обрывков
# «100% 2976KB 2.9MB/s» — сведений, которые ни на что не влияют. Размер
# артефакта печатается отдельной строкой на шаге упаковки.
SCP=(scp -i "$DEPLOY_KEY" -o StrictHostKeyChecking=yes)
(( VERBOSE )) || SCP+=(-q)

# Версия. Ровно две метки, и по имени релиза всегда видно, откуда он взялся:
#
#   release-<дата>-<коммит>   уехало из пайплайна
#   manual-<дата>-<коммит>    выкачено руками с машины разработчика
#
# Состояние рабочего дерева в имя не попадает: локальная выкатка почти всегда
# идёт из дерева с правками, и метка «dirty» не несла информации — а вот
# «manual» отличает её от релиза сразу и однозначно.
KIND="${DEPLOY_KIND:-manual}"          # пайплайн выставляет DEPLOY_KIND=release
if git rev-parse --git-dir >/dev/null 2>&1; then
    VERSION="$KIND-$(msk '%Y%m%d-%H%M%S')-$(git rev-parse --short HEAD)"

    # Коммит обязан существовать где-то, кроме этой машины. Иначе по релизу на
    # сервере нельзя узнать, какой код там работает: на проде Snakes так и
    # оказался коммит, которого нет ни в одной ветке и ни на одном remote —
    # версия есть, а восстановить по ней нечего.
    if [[ -z "$(git branch -r --contains HEAD 2>/dev/null)" ]] && ! (( ALLOW_UNPUSHED )); then
        die "коммит $(git rev-parse --short HEAD) не запушен ни в одну удалённую ветку.
   Выкатив его, вы получите на сервере код, который невозможно восстановить.
   Запушьте ветку либо, если это осознанно, добавьте --allow-unpushed"
    fi
else
    VERSION="$KIND-$(msk '%Y%m%d-%H%M%S')"
fi

# У цели-файла версию объявляет сам проект, а не метка manual-<дата>: она
# уезжает В СБОРКУ (у лаунчера — в launcher.version каждому скачавшему) и
# обязана совпадать с тем, что проект считает своей версией. Ровно ту же
# команду выполняет шаг «Версия релиза» в desktop-artifact.yml — источник
# один на оба пути. Молчаливого запасного значения нет: публиковать
# установщик с заглушкой вместо версии нельзя.
if (( PUBLISH_MODE )); then
    [[ -n "${VERSION_CMD:-}" ]] || die "у цели с PUBLISH_DEST в описании нет VERSION_CMD — версию сборки объявляет проект"
    VERSION="$(bash -c "$VERSION_CMD" | tr -d ' \t\r\n')"
    [[ -n "$VERSION" ]] || die "VERSION_CMD не напечатала версию — публиковать сборку без версии нельзя"
fi

echo "приложение:  $APP"
echo "версия:      $VERSION"
echo "сервер:      $DEPLOY_USER@$DEPLOY_HOST"
if (( PUBLISH_MODE )); then
    echo "файл:        $PUBLISH_DEST"
else
    echo "каталог:     $ROOT"
fi

# --- сборка ---------------------------------------------------------------
#
# Вывод сборщика по умолчанию НЕ печатается, а уезжает в файл.
#
# Он занимал девять десятых всего вывода `dk deploy --all`: npm печатает про
# фандинг и уязвимости, vite — таблицу размеров бандла, astro — список
# сгенерированных маршрутов. При одной цели это терпимо, при одиннадцати
# результат выкатки тонет в чужих логах, и «что именно произошло» приходится
# искать глазами.
#
# При провале лог печатается целиком: там причина, и прятать её нельзя.
# Целиком же его показывает --verbose (или DK_VERBOSE=1) — когда сборку
# отлаживают, а не просто катят.
if (( BUILD )) && [[ -n "${BUILD_CMD:-}" ]]; then
    if (( DRY )); then
        log "сборка пропущена (dry-run): $BUILD_CMD"
    else
        BUILD_LOG="$(mktemp -t "${APP}-build-XXXXXX.log")"
        log "сборка"
        # Сборке доступны версия и архитектура — тем же способом, что и в CI,
        # чтобы команда в описании цели была одна на оба пути.
        # `|| rc=$?`, а не `rc=$?` отдельной строкой: при set -e падение сборки
        # убивает скрипт ДО присваивания, и тогда ни лог, ни причина до
        # человека не доезжают — остаётся молчаливый выход с чужим кодом.
        # Проверено: без этого провал сборки печатал только «сборка».
        rc=0
        if (( VERBOSE )); then
            # pipefail уже включён, поэтому статус пайплайна — статус сборки,
            # а не tee.
            DEPLOY_VERSION="$VERSION" DEPLOY_GOARCH="${GOARCH:-}" \
                bash -c "$BUILD_CMD" 2>&1 | tee "$BUILD_LOG" || rc=$?
        else
            DEPLOY_VERSION="$VERSION" DEPLOY_GOARCH="${GOARCH:-}" \
                bash -c "$BUILD_CMD" > "$BUILD_LOG" 2>&1 || rc=$?
        fi
        if (( rc != 0 )); then
            warn "сборка провалилась: $BUILD_CMD"
            # Лог целиком, а не хвост: причина падения сборки часто в первой
            # строке (не тот node, нет зависимости), а хвост показывает лишь
            # «команда завершилась с кодом 1».
            cat "$BUILD_LOG" >&2
            rm -f "$BUILD_LOG"
            die "выкатка $APP не начата"
        fi
        rm -f "$BUILD_LOG"
        ok "собрано"
    fi
fi
# В dry-run сборки не было, поэтому и артефакта может не быть — это не ошибка.
if ! (( DRY )); then
    if (( PUBLISH_MODE )); then
        [[ -f "$ARTIFACT_FILE" ]] || die "нет файла $ARTIFACT_FILE — сборка не выполнялась?"
        [[ -s "$ARTIFACT_FILE" ]] || die "файл $ARTIFACT_FILE пуст — публиковать нечего"
    else
        [[ -d "$ARTIFACT_DIR" ]] || die "нет каталога $ARTIFACT_DIR — сборка не выполнялась?"
    fi
fi

# --- список изменений -----------------------------------------------------
#
# Генератор зовётся РОВНО ОДИН раз, и вот здесь, а не в каждом из двух мест,
# где список нужен.
#
# А нужен он дважды: в version.json (пишется прямо ниже, до выкатки) и в
# сообщении о релизе (notify живёт в ловушке EXIT, то есть срабатывает в самом
# конце, когда выкатка уже прошла). Между этими двумя моментами лежит вся
# выкатка целиком — упаковка, загрузка артефакта, release.sh на сервере, — это
# минуты. Второй вызов генератора за это время вернул бы ДРУГОЙ список:
# достаточно коммита в соседнем окне или свежего тега. Тогда /version.json на
# проде и сообщение в чате рассказывали бы про разные изменения, причём
# статус-бот сверяет ровно эти два источника — расхождение читалось бы как
# «бот врёт», а не «список посчитан дважды».
#
# Отсюда и место вызова: непосредственно перед самым ранним потребителем.
#
# Через `bash`, а не напрямую: в этом репозитории core.filemode=false и bin/*
# лежат в индексе как 100644 — на свежем клоне под Linux файл неисполняемый.
#
# timeout — страховка на время, а не на код возврата. Сам changelog обещает
# «не может уронить выкатку», но обещание про КОД ВОЗВРАТА: зависший генератор
# держал бы выкатку до таймаута задачи, и теперь — ДО загрузки артефакта, а не
# после неё. Нет timeout (урезанный образ, BusyBox) — зовём как есть.
#
# stderr генератора НЕ глушится — ровно как в обоих workflow. Там одна строка:
# по какому диапазону посчитан список, а если списка нет — почему его нет
# («не git-репозиторий», «все коммиты отфильтрованы как шум»). Отправив её в
# /dev/null, мы вернули бы сюда ту самую беду, из-за которой заведён и сам
# генератор, и предупреждение о ненастроенном чате ниже: пустой блок изменений
# становится неотличим от выключенного, и объяснять «а почему в сообщении
# ничего нет» нечем. Одна строка в выводе локальной выкатки стоит дёшево.
#
# В сухом прогоне список не нужен никому: version.json не пишется, а notify
# на dry-run выходит сразу.
# БАЗА ССЫЛОК НА PR. Генератор срезает с темы хвост «(#NN)», который GitHub
# дописывает при сквош-мерже, и умеет вернуть номер КЛИКАБЕЛЬНОЙ ссылкой — но
# только если ему сказать, на какой репозиторий ссылаться. В пайплайне базу
# даёт github.repository, здесь взять её больше неоткуда, кроме как из remote.
#
# Нормализуются обе формы, в которых remote встречается в хозяйстве, потому
# что обе — норма: ssh ставится по умолчанию `gh repo clone`, https — кнопкой
# «Clone» на сайте, и в одном хозяйстве живут вперемешку.
#
#   git@github.com:tr0llex/deploy-kit.git        → https://github.com/tr0llex/deploy-kit
#   https://github.com/tr0llex/deploy-kit.git    → https://github.com/tr0llex/deploy-kit
#   ssh://git@github.com:22/tr0llex/deploy-kit   → https://github.com/tr0llex/deploy-kit
#
# ЭТО НЕ МОЖЕТ УРОНИТЬ ВЫКАТКУ И НЕ ДОЛЖНО. Нет remote (свежий локальный
# репозиторий, зеркало, каталог без git), remote незнакомой формы, старый git
# без `remote get-url` — функция возвращает 1, флаг не передаётся, и список
# изменений выходит ровно таким, каким был до этой правки. Ссылка на номер PR
# — украшение поверх украшения, и цена ей соответствующая.
#
# Хост обязан содержать точку. Проверка выглядит придиркой ровно до Windows:
# `C:/src/repo` — это допустимый локальный remote, и без этого условия он
# разобрался бы как хост `C` с путём `src/repo`, то есть дал бы ссылку
# https://C/src/repo/pull/21 в каждом пункте. Ссылка в никуда хуже её
# отсутствия: отсутствие видно сразу, а неверная ссылка — только по клику.
normalize_remote() { # normalize_remote <url> → https://host/owner/repo
    local url="$1" hostpath host path
    [[ -n "$url" ]] || return 1
    case "$url" in
        # Любая схема: https://, ssh://, git://, git+ssh://. Дальше от них всех
        # нужны ровно хост и путь.
        *://*) hostpath="${url#*://}" ;;
        # scp-подобная форма git@host:owner/repo — двоеточие вместо слэша.
        *:*)   hostpath="${url%%:*}/${url#*:}" ;;
        *)     return 1 ;;
    esac
    host="${hostpath%%/*}"; path="${hostpath#*/}"
    host="${host##*@}"      # git@ / user@ — учётка, а не часть адреса
    host="${host%%:*}"      # порт ssh:// в http-ссылке не значит ничего
    path="${path#/}"        # ssh://host/owner/repo даёт ведущий слэш
    path="${path%/}"; path="${path%.git}"; path="${path%/}"
    [[ "$host" == *.* ]] || return 1
    [[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || return 1
    # Путь — минимум владелец/репозиторий. Подгруппы GitLab дают больше уровней
    # и тоже проходят; чего быть не должно — пробелов, обратных слэшей и «..».
    [[ "$path" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$ ]] || return 1
    printf 'https://%s/%s' "$host" "$path"
}

link_base() {
    local raw=""
    # Явное указание сильнее вывода из remote: у зеркал и у форков remote
    # показывает не тот репозиторий, куда ведут номера PR.
    [[ "${LINK_BASE:-}" == none ]] && return 1
    if [[ -n "${LINK_BASE:-}" ]]; then printf '%s' "${LINK_BASE%/}"; return 0; fi
    # `remote get-url` появился в git 2.7; на старом git берём то же из конфига.
    raw="$(git --no-optional-locks -C "$PROJECT_REPO" remote get-url origin 2>/dev/null || true)"
    [[ -n "$raw" ]] || raw="$(git --no-optional-locks -C "$PROJECT_REPO" config --get remote.origin.url 2>/dev/null || true)"
    raw="${raw%%$'\n'*}"; raw="${raw//$'\r'/}"
    normalize_remote "$raw"
}

# ФЛАГИ ГЕНЕРАТОРА ПРОВЕРЯЮТСЯ, А НЕ ПРЕДПОЛАГАЮТСЯ.
#
# bin/changelog на НЕЗНАКОМЫЙ аргумент отвечает строкой в stderr и ПУСТЫМ
# stdout. Значит лишний флаг стоил бы не ссылки на PR, а всего списка целиком —
# и стоил бы молча, потому что пустой список выглядит как «изменений нет».
#
# Спрашивать, а не предполагать, приходится и потому, что версий генератора в
# хозяйстве одновременно две: этот скрипт зовёт соседний файл из своего
# репозитория, а оба workflow тянут bin/changelog с main по HTTP. Обновляются
# они независимо, и «у меня работает» здесь ничего не значит.
#
# Пробный вызов дешёвый: заведомо не-репозиторий, --quiet гасит всё, кроме
# сообщения о неизвестном аргументе, git не читается вовсе.
cl_knows() { # cl_knows <флаг> [значение]
    local err
    [[ -r "$KIT_DIR/bin/changelog" ]] || return 1
    err="$(bash "$KIT_DIR/bin/changelog" "$@" --quiet --repo "$KIT_DIR/.dk-not-a-repo" 2>&1 >/dev/null || true)"
    [[ "$err" != *"неизвестный аргумент"* ]]
}

CHANGELOG=""
if ! (( DRY )); then
    CL_ARGS=(--repo "$PROJECT_REPO")

    # ПОЛНЫЙ СПИСОК, А НЕ ПЕРВЫЕ ВОСЕМЬ ПУНКТОВ.
    #
    # Порядок здесь решает всё: список режется дважды, и первый рез —
    # окончательный. Что генератор не отдал, того нет в version.json, а чего
    # нет в version.json, того не покажет ни статус-страница, ни бот: они
    # читают файл, а не историю git. Прежний хвост «…и ещё 1 коммит» — худшее
    # из обоих миров: строку занимает, а какой это коммит — не говорит.
    #
    # Поэтому генератор зовётся в неограниченном режиме, а разбираться с
    # лимитом Telegram — дело notify(): он делит список на несколько сообщений,
    # ничего не теряя.
    #
    # Неограниченный режим у генератора — это НОЛЬ в обоих пределах, а не
    # отдельный флаг: `--max 0` и `--budget 0` значат «без предела» (свои
    # потолки — 200 пунктов и 20000 видимых символов — генератор держит сам,
    # и это правильно: бесконечного списка не бывает).
    #
    # Пробного вызова тут поэтому нет и быть не может: оба флага генератор знал
    # всегда, спрашивать нечего. Старый генератор, не знающий нуля, посчитает
    # его мусором и молча возьмёт умолчания — то есть вернётся к сегодняшнему
    # поведению. Молча — это плохо, поэтому обрезку ловим по хвосту ниже.
    CL_ARGS+=(--max 0 --budget 0)

    # База ссылок — только если генератор умеет её принимать И она вывелась.
    CL_LINK_BASE="$(link_base || true)"
    if [[ -n "$CL_LINK_BASE" ]] && cl_knows --link-base "$CL_LINK_BASE"; then
        CL_ARGS+=(--link-base "$CL_LINK_BASE")
    elif [[ -n "$CL_LINK_BASE" ]]; then
        log "генератор списка изменений не знает --link-base — номера PR останутся без ссылок"
    fi

    if command -v timeout >/dev/null 2>&1; then
        CHANGELOG="$(timeout 20 bash "$KIT_DIR/bin/changelog" "${CL_ARGS[@]}" || true)"
    else
        CHANGELOG="$(bash "$KIT_DIR/bin/changelog" "${CL_ARGS[@]}" || true)"
    fi

    # Обрезка, если она всё-таки случилась, называется вслух.
    #
    # Владелец просил обратного: «не обрезай все релизнутые коммиты, сейчас
    # обрезается со словами „…и ещё 1 коммит“ и не ясно какой». Пределы сняты
    # выше, и в норме этого хвоста не бывает вовсе — а раз не бывает, то его
    # появление означает ровно два случая, и оба стоит увидеть: генератор
    # старый (нуля не понял, взял умолчания) либо релиз упёрся в собственный
    # потолок генератора в 200 коммитов.
    #
    # Проверяется ПОСЛЕДНЯЯ строка целиком, а не вхождение подстроки: «…и ещё»
    # посреди темы коммита — обычный текст, а не признак обрезки.
    if [[ "${CHANGELOG##*$'\n'}" == "…и ещё "* ]]; then
        warn "список изменений вернулся обрезанным: «${CHANGELOG##*$'\n'}».
   Пределы генератору сняты (--max 0 --budget 0) — значит либо bin/changelog старый и нуля не понимает,
   либо релиз упёрся в его потолок. В чат и в version.json уедет неполный список."
    fi
fi

# --- отметка версии -------------------------------------------------------
# Кладём version.json прямо в артефакт: по нему выкатка себя проверяет, и его
# же читает агент статус-страницы.

# Экранирование строки для JSON — посимвольно, без sed и без ${s//…/…}.
#
# Сюда приезжают темы коммитов, то есть чужой текст: кавычки, обратные слэши,
# переводы строк, изредка управляющие символы из копипасты. Наивная подстановка
# ломает файл на первой же теме вида «поправить путь C:\Users\x» или «убрать
# "лишний" вызов», а невалидный version.json — это не косметика: его читает
# версионный шлюз, чтобы отличить «выкатилось» от «выглядит выкаченным».
# То есть украшение поверх выкатки уронило бы проверку самой выкатки.
#
# Почему не ${s//\\/\\\\}: в bash 5.2+ символ & в СТРОКЕ ЗАМЕНЫ значит «то, что
# совпало», и правила для обратного слэша там же разъехались — одна и та же
# строка на раннере и на машине разработчика экранируется по-разному. Ровно на
# эти грабли уже наступил bin/changelog (см. esc_html), второй раз не надо.
# Посимвольный проход от локали и версии bash не зависит вовсе.
#
# Многобайтные символы проходят насквозь: и при LC_ALL=C (побайтно), и в
# UTF-8-локали (посимвольно) байты на выходе те же — а UTF-8 внутри JSON-строки
# допустим как есть. Экранируются только то, что обязано: " \ и всё < 0x20.
json_escape() {
    local s="$1" out="" n i ch code hex
    n=${#s}
    for (( i = 0; i < n; i++ )); do
        ch="${s:i:1}"
        case "$ch" in
            '"')   out+='\"'  ;;
            '\')   out+='\\'  ;;
            $'\n') out+='\n'  ;;
            $'\r') out+='\r'  ;;
            $'\t') out+='\t'  ;;
            $'\b') out+='\b'  ;;
            $'\f') out+='\f'  ;;
            *)
                printf -v code '%d' "'$ch"
                if (( code >= 0 && code < 32 )); then
                    printf -v hex '%04x' "$code"
                    out+="\\u$hex"
                else
                    out+="$ch"
                fi
                ;;
        esac
    done
    printf '%s' "$out"
}

# У цели-файла version.json не бывает: артефакт — один файл, класть отметку
# некуда, а сверку «прод раздаёт именно эту сборку» делает VERIFY_URL ниже.
if (( PUBLISH_MODE )); then
    :
elif [[ "${WRITE_VERSION_FILE:-1}" == "1" ]] && ! (( DRY )); then
    # Кладём в public/, если он есть: сервис раздаёт статику именно оттуда,
    # и только так файл окажется доступен по /version.json — а значит, шаг
    # сверки версии сможет отличить «выкатилось» от «выглядит выкаченным».
    VDIR="$ARTIFACT_DIR"; [[ -d "$ARTIFACT_DIR/public" ]] && VDIR="$ARTIFACT_DIR/public"

    # Ключ "changelog" НЕОБЯЗАТЕЛЬНЫЙ и появляется только когда есть что
    # показать. Пустого "changelog":"" быть не должно: агент разбирает поле
    # терпимо, но пустая строка — это «изменений нет», а не «список не
    # считался», и на странице статуса появился бы пустой блок «Изменения».
    # Собирается отдельным хвостом, потому что условного ключа в printf нет.
    #
    # Значение — ДОСЛОВНЫЙ stdout генератора, вместе со строкой <b>Изменения</b>
    # и маркерами: разбирает и нормализует его читатель (agent), а писателей у
    # этого файла три (два workflow и вот этот скрипт), и договориться проще
    # об «отдай как есть», чем о трёх одинаковых нормализациях.
    VJSON_TAIL=""
    if [[ -n "$CHANGELOG" ]]; then
        VJSON_TAIL=",\"changelog\":\"$(json_escape "$CHANGELOG")\""
    fi

    printf '{"version":"%s","commit":"%s","builtAt":"%s"%s}\n' \
        "$VERSION" "$(git rev-parse --short HEAD 2>/dev/null || echo local)" \
        "$(msk '%Y-%m-%dT%H:%M:%S+03:00')" "$VJSON_TAIL" > "$VDIR/version.json"
    ok "version.json записан в ${VDIR#$PWD/}"
fi

# --- уведомление ----------------------------------------------------------
#
# Локальная выкатка молчала в чат, а выкатка из CI — писала. Разница была не
# задумана, а просто не сделана: шаг уведомления живёт в workflow, и до
# bin/deploy его никто не донёс. Практическое следствие неприятное: сообщения
# в чате перестают быть летописью прода. «Ничего не приходило» начинает
# означать «либо ничего не катилось, либо катилось руками» — а это разные вещи.
#
# Токен и чат берутся из dk.conf, как хост и ключ.
#
# Молчание здесь бывает двух разных сортов, и раньше они выглядели одинаково:
#
#   NOTIFY=never (или fail при успехе) — молчание ПО ЗАМЫСЛУ, говорить не о чем;
#   нет TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID — уведомление ХОТЕЛИ, но не смогли.
#
# Второй случай молчал ровно так же, как первый, и «в чат ничего не пришло»
# нельзя было отличить от «уведомления выключены». Поэтому теперь про
# ненастроенный чат говорится вслух — предупреждением, но не провалом выкатки:
# выкатка состоялась, а уведомление — украшение поверх неё.

# ДЛИНА В ЕДИНИЦАХ UTF-16 — ровно так и только так считает Telegram.
#
# Ни байты, ни символы здесь не годятся, и ошибаются они в РАЗНЫЕ стороны.
#
# Байты ошибаются в запас, но запас этот разорительный: кириллическая буква —
# два байта и ОДНА единица UTF-16. В 4096 байт влезает 2048 русских букв, в
# 4096 единиц — все 4096. Байтовая проверка делила бы русский список надвое
# там, где он преспокойно уезжает одним сообщением.
#
# Символы ошибаются в опасную сторону: 🚀 (U+1F680) — ОДИН символ, но за
# пределами BMP, а в UTF-16 такой символ занимает суррогатную пару, то есть
# ДВЕ единицы. Символьный счёт недосчитал бы, а недосчёт на границе — это
# отказ API и не пришедшее сообщение, то есть ровно то, чего мы избегаем.
#
# Отсюда точная формула: единиц = символов + сколько символов вне BMP. По
# UTF-8 видно и то, и другое, причём из одних байтов: продолжения символа —
# 0x80–0xBF (их выбрасываем, остаются начала символов), а четырёхбайтная
# последовательность (ведущий байт 0xF0–0xF4) — это ровно то, что в BMP не
# поместилось.
#
# LC_ALL=C — локальный и только на время функции: bin/deploy в отличие от
# bin/changelog работает в локали машины, и менять её всему скрипту ради счёта
# нельзя (json_escape рассчитан на обе). А внутри функции она обязательна:
# без неё ${#…} считает символы, а диапазон [\x80-\xbf] в UTF-8-локали не
# значит того, что написано. Проверено на C, C.UTF-8, en_US.UTF-8, ru_RU.UTF-8
# — против iconv в UTF-16LE счёт совпадает во всех четырёх.
u16len() {
    local LC_ALL=C
    local s="$1" chars lead
    chars="${s//[$'\x80'-$'\xbf']/}"
    lead="${chars//[$'\xf0'-$'\xf4']/}"
    printf '%s' $(( ${#chars} + ${#chars} - ${#lead} ))
}

# 4096 — жёсткий предел Telegram: длиннее он не режет, а ОТКАЗЫВАЕТ. Шлём по
# 3900, и запас в 196 единиц здесь не суеверие, а плата за две неточности,
# каждая из которых нам неподконтрольна: считаем мы разметку целиком (Telegram
# после разбора HTML считает меньше — то есть мы завышаем, и это в нашу
# пользу), а вот как именно он округляет свои же лимиты, в документации не
# написано. Дешевле отдать 5% места, чем выяснять это на живом релизе.
TG_SAFE=3900
# Место под строку «часть 3 из 7» бронируется заранее, потому что число частей
# становится известно только после того, как список уже поделён. Считать её
# длину задним числом — значит выйти за предел ровно на ней. 64 единицы —
# втрое от самой длинной вообразимой («<i>часть 100 из 100</i>» — 25).
TG_RESERVE=64

# ДЕЛЕНИЕ СООБЩЕНИЯ. Список изменений уезжает ЦЕЛИКОМ, несколькими
# сообщениями подряд, а не обрезается.
#
# Почему не обрезать — сказано владельцем прямо: обрезка стоит строки и не
# сообщает ничего («…и ещё 1 коммит» — какой именно?). Почему не «ужать» —
# потому что ужимать нечего: тема коммита и так уложена генератором в 120
# символов, а сорок коммитов по 120 символов — это около 4800 единиц, и в
# 4096 они не влезут никакой правкой формулировок.
#
# Правила деления:
#
#   1. Режем ТОЛЬКО по границам строк. Пункт списка — это одна мысль об одном
#      коммите; разорванный посередине, он не читается ни в одной из частей.
#   2. Порядок сохраняется, ни одна строка не теряется и не дублируется:
#      каждая попадает ровно в одну часть, в том же порядке.
#   3. Части нумеруются — «часть 2 из 3». Это не украшение: без номера
#      недоставленная середина выглядит как конец списка, то есть как успех.
#      Читатель обязан видеть дыру сам, не полагаясь на наши логи.
#   4. Продолжение подписано именем приложения и версией: сообщения в чате
#      перемешиваются с чужими (катится одиннадцать целей), и «• …» без
#      подписи неизвестно к чему относится.
#   5. Одно сообщение — никаких номеров и никаких подписей. Обычный релиз
#      влезает в одно, и платить за редкий случай постоянным шумом незачем.
#
# Единственный случай, когда часть всё-таки может не влезть, — одна строка
# длиннее целого сообщения. Генератор такого не отдаёт (его --width — 120
# символов, то есть не более ~130 единиц), а если когда-нибудь отдаст, строка
# уедет отдельной частью и Telegram откажет ИМЕННО на ней — с внятным
# предупреждением ниже, а не молча.
MSGS=()
split_msgs() { # split_msgs <первое сообщение> <шапка продолжения> <список>
    local head="$1" cont="$2" body="$3"
    local line cur cur_len cont_len line_len n i
    MSGS=()
    if [[ -z "$body" ]]; then MSGS=("$head"); return 0; fi

    cont_len="$(u16len "$cont")"
    cur="$head"; cur_len="$(u16len "$head")"
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_len="$(u16len "$line")"
        # +1 — перевод строки перед пунктом. Резерв учитывается на каждом шаге,
        # а не в конце: хвост «часть k из N» получит КАЖДАЯ часть, включая ту,
        # которую мы сейчас набиваем.
        if (( cur_len + 1 + line_len + TG_RESERVE <= TG_SAFE )); then
            cur="$cur"$'\n'"$line"
            cur_len=$(( cur_len + 1 + line_len ))
        else
            MSGS+=("$cur")
            cur="$cont"$'\n'"$line"
            cur_len=$(( cont_len + 1 + line_len ))
        fi
    done <<< "$body"
    MSGS+=("$cur")

    n=${#MSGS[@]}
    (( n > 1 )) || return 0
    for (( i = 0; i < n; i++ )); do
        MSGS[i]="${MSGS[i]}"$'\n'"<i>часть $(( i + 1 )) из $n</i>"
    done
    return 0
}

# Одна отправка. Ответ Telegram проверяется, а не выбрасывается: раньше здесь
# стоял `>/dev/null || true`, и протухший токен, чужой chat_id и оборванная
# сеть выглядели точно так же, как успешная отправка, — то есть никак.
# Провалом выкатки это по-прежнему не считается, наружу всегда 0.
TG_WHY=""
tg_send() { # tg_send <токен> <чат> <текст> → 0 отправлено, 1 нет (причина в TG_WHY)
    local token="$1" chat="$2" text="$3" resp=""
    TG_WHY=""
    # Текст уезжает ЧЕРЕЗ STDIN (`text@-`), а не аргументом `text=…`, и это не
    # вкусовщина. На Windows выкатка идёт из Git Bash, а curl там НАТИВНЫЙ:
    # аргументы ему msys перекодирует в системную кодовую страницу. Проверено
    # локально — «🚀 привет» в аргументе уезжает как `%3F%3F+%EF%F0%E8%E2%E5%F2`
    # (эмодзи двумя «?» по суррогатной паре, кириллица в CP1251), и в чат
    # приходит строка сплошных «?». Через stdin те же символы уходят
    # `%F0%9F%9A%80+%D0%BF…` — байт в байт UTF-8. На Linux и macOS не меняется
    # ничего.
    #
    # Файлом (`text@файл`) сделать нельзя: путь от mktemp остаётся POSIX-ным, а
    # нативный curl его не понимает — curl отвечает «error encountered when
    # reading a file» и не отправляет НИЧЕГО. Это проверено там же.
    #
    # Тот же дефект жил в notify установщика: он исполняется на
    # windows-раннере, и текст там теперь тоже уезжает через stdin —
    # см. шаг «Уведомить в Telegram» в desktop-artifact.yml.
    resp="$(printf '%s' "$text" \
        | curl -s -m 15 -X POST "https://api.telegram.org/bot$token/sendMessage" \
            -d chat_id="$chat" -d parse_mode=HTML -d disable_web_page_preview=true \
            --data-urlencode "text@-" 2>/dev/null || true)"
    [[ "$resp" =~ \"ok\"[[:space:]]*:[[:space:]]*true ]] && return 0
    # В причину попадает только описание ошибки от API: URL с токеном не
    # печатается никогда и никуда.
    TG_WHY="$(printf '%s' "$resp" \
        | sed -n 's/.*"description"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [[ -n "$TG_WHY" ]] || TG_WHY="api.telegram.org не ответил (сеть, таймаут или отказ curl)"
    return 1
}

notify() {
    local status="$1"
    local token="${TELEGRAM_BOT_TOKEN:-}" chat="${TELEGRAM_CHAT_ID:-}"

    # Сухой прогон ничего не выкатывал — и говорить о нём нечего, в том числе
    # про ненастроенный чат: `dk deploy --all --dry-run` иначе выдал бы
    # одиннадцать одинаковых предупреждений ни о чём.
    (( DRY )) && return 0

    # Правила те же, что в CI (см. шаг «Уведомить в Telegram»): об успехе можно
    # молчать, о провале — нельзя. Невыкаченное, о котором не сказали, выглядит
    # как выкаченное.
    #
    # Проверка стоит ПЕРЕД проверкой токена: при NOTIFY=never чат не нужен, и
    # предупреждать о его отсутствии значит шуметь там, где молчания и просили.
    case "${NOTIFY:-all}:$status" in
        never:*)      return 0 ;;
        fail:success) return 0 ;;
    esac

    if [[ -z "$token" || -z "$chat" ]]; then
        warn "уведомление о выкатке не отправлено: нет TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID.
   Задайте их в $DK_CONF_FILE (образец — dk.conf.example) либо NOTIFY=never в описании цели, чтобы не спрашивать."
        return 0
    fi

    # У цели-файла глагол другой: она не «выкатывается» релизом, а публикуется
    # подменой файла. Слово то же, что в сообщении desktop-artifact.yml, чтобы
    # лента в чате читалась одинаково с обоих путей.
    local verb="выкачен" fail_what="выкатка"
    if (( PUBLISH_MODE )); then verb="опубликован"; fail_what="публикация"; fi

    local text cont=""
    if [[ "$status" == success ]]; then
        text=$(printf '🚀 <b>%s</b> %s\n<code>%s</code>\nвыкатка с машины разработчика' "$APP" "$verb" "$VERSION")
        [[ -n "${HEALTH:-}" ]] && text=$(printf '%s\n<a href="%s">открыть</a>' "$text" "$HEALTH")

        # Список изменений — общий генератор на все пути выкатки (два workflow
        # и этот скрипт), чтобы лента релизов читалась одинаково. Блок идёт
        # последним и только в сообщении об успехе: сообщение о провале должно
        # оставаться про провал.
        #
        # Генератор здесь уже НЕ зовётся: список посчитан один раз выше, до
        # записи version.json (там же расписано, почему именно один раз). В чат
        # и в version.json уходит поэтому одна и та же строка — дословно.
        #
        # Форма `if`, а не `[[ … ]] && …`: при пустом changelog такая строка
        # вернула бы 1, а notify зовётся из ловушки EXIT. Умолчание ${…:-} по
        # той же причине: ловушка обязана пережить любую перестановку кода
        # выше, а необъявленная переменная под set -u уронила бы её саму.
        #
        # Целиком в одно сообщение список может и не влезть — тогда split_msgs
        # разложит его на несколько, ничего не потеряв. Шапка продолжения
        # называет приложение и версию: в чате рядом лежат сообщения о десяти
        # других целях, и «• …» без подписи неизвестно к чему относится.
        cont=$(printf '🚀 <b>%s</b> <code>%s</code> — продолжение списка изменений' "$APP" "$VERSION")
        split_msgs "$text" "$cont" "${CHANGELOG:-}"
    else
        text=$(printf '💥 <b>%s</b> — %s провалена\n<code>%s</code>\nвыкатка с машины разработчика' "$APP" "$fail_what" "$VERSION")
        split_msgs "$text" "" ""
    fi

    # Части уходят ПО ПОРЯДКУ и по одной: Telegram показывает их в том порядке,
    # в котором принял, и параллельная отправка перемешала бы список.
    #
    # На первой же неудаче отправка прекращается. Досылать хвост после дыры —
    # значит выдать неполный список за полный: части пронумерованы, и читатель
    # увидит «часть 1 из 3» без второй, а вот «1 из 3» и сразу «3 из 3» он
    # прочтёт как «всё пришло, просто вторая где-то задержалась».
    local i n=${#MSGS[@]}
    for (( i = 0; i < n; i++ )); do
        tg_send "$token" "$chat" "${MSGS[i]}" && continue

        if (( n == 1 )); then
            warn "уведомление о выкатке не доставлено: $TG_WHY"
        else
            # Провалом выкатки это не является (выкатка состоялась), но и
            # успехом уведомление не является тоже — поэтому говорится вслух,
            # с номером части: «сообщение не пришло» и «пришла половина
            # списка» чинятся по-разному.
            warn "уведомление о выкатке доставлено НЕ ЦЕЛИКОМ: часть $(( i + 1 )) из $n не ушла ($TG_WHY).
   Ушло частей: $i из $n, остальные не отправлялись — иначе список в чате выглядел бы полным.
   Полный список изменений лежит в version.json выкаченного релиза."
        fi
        return 0
    done
    return 0
}

# Итог считается провалом, пока не доказано обратное: die выходит из любого
# места скрипта, и перечислять все его точки в уведомлении пришлось бы руками.
DEPLOY_STATUS=failure

# --- упаковка -------------------------------------------------------------
TARBALL="$(mktemp -t "${APP}-XXXXXX").tar.gz"

# Каталог на сервере, куда кладётся всё, что потом читает root.
#
# Раньше это были предсказуемые /tmp/<app>-site.conf и /tmp/<app>-<версия>.tar.gz.
# Их имена известны заранее, /tmp пишет кто угодно, а читает их sudo'шный
# nginx-apply.sh (install в /etc/nginx) и release.sh (tar -xzf от root). Между
# загрузкой и чтением есть окно, и подменить файл или подставить симлинк в это
# окно может любой локальный пользователь. mktemp -d даёт каталог 0700 с
# непредсказуемым именем — окна не остаётся.
REMOTE_TMP=""
remote_tmp() {
    [[ -n "$REMOTE_TMP" ]] && return 0
    # `|| true` внутри подстановки: при pipefail упавший ssh убил бы
    # присваивание молча, до того как сработает внятное сообщение ниже.
    REMOTE_TMP="$("${SSH[@]}" 'mktemp -d /tmp/dk-XXXXXXXXXX' 2>/dev/null | tr -d '\r' | tail -1 || true)"
    [[ "$REMOTE_TMP" == /* ]] || die "не удалось создать временный каталог на сервере"
}

cleanup() {
    rm -f "$TARBALL"
    if [[ -n "$REMOTE_TMP" ]]; then
        "${SSH[@]}" "rm -rf -- $(printf '%q' "$REMOTE_TMP")" >/dev/null 2>&1 || true
    fi
    notify "$DEPLOY_STATUS"
}
trap cleanup EXIT

# --- публикация цели-файла ---------------------------------------------------
#
# Путь короткий и свой: ни упаковки, ни preflight, ни release.sh. Сумма
# считается здесь, проверяется publish-file.sh на сервере ДО подмены (обрыв
# scp не доедет до пользователей) и сверяется с прода ПОСЛЕ («зелёный деплой
# со старыми файлами» ловится ровно здесь — как сверка /version.json у
# обычных целей). Шаги и их порядок — те же, что в desktop-artifact.yml.
if (( PUBLISH_MODE )); then
    if (( DRY )); then
        log "публикация пропущена (dry-run): $ARTIFACT_FILE → $PUBLISH_DEST"
        DEPLOY_STATUS=success
        exit 0
    fi

    command -v sha256sum >/dev/null 2>&1 || die "нет команды sha256sum"
    SHA="$(sha256sum -- "$ARTIFACT_FILE" | cut -d' ' -f1)"
    BASE="$(basename -- "$PUBLISH_DEST")"
    printf '%s  %s\n' "$SHA" "$BASE" > "$ARTIFACT_FILE.sha256"
    ok "артефакт: $(du -h -- "$ARTIFACT_FILE" | cut -f1), SHA-256 $SHA"

    remote_tmp
    log "загружаю артефакт"
    "${SCP[@]}" "$ARTIFACT_FILE" "$DEPLOY_USER@$DEPLOY_HOST:$REMOTE_TMP/$BASE"
    "${SCP[@]}" "$ARTIFACT_FILE.sha256" "$DEPLOY_USER@$DEPLOY_HOST:$REMOTE_TMP/$BASE.sha256"

    log "публикую на сервере"
    PUB_ARGS=(--file "$REMOTE_TMP/$BASE" --sha256 "$REMOTE_TMP/$BASE.sha256" --dest "$PUBLISH_DEST")
    "${SSH[@]}" "sudo /opt/deploy-kit/publish-file.sh $(printf '%q ' "${PUB_ARGS[@]}")" \
        || die "публикация $APP провалена — на сервере остался прежний файл"

    if [[ -n "${VERIFY_URL:-}" ]]; then
        GOT="$(curl -fsS --max-time 30 "$VERIFY_URL" 2>/dev/null | awk '{print tolower($1); exit}' || true)"
        [[ -n "$GOT" ]] || die "$VERIFY_URL не отдал контрольную сумму — публикация не подтверждена"
        [[ "$GOT" == "$SHA" ]] || die "прод раздаёт другую сборку: собрано $SHA, по адресу $VERIFY_URL лежит $GOT"
        ok "проверено: $VERIFY_URL раздаёт свежую сумму"
    fi

    # Третий канал цели-файла — сборка самообновления в админку лаунчера.
    # Скрипт общий с desktop-artifact.yml; latest.json он не переключает
    # никогда (это ручной шаг в админке — граница автоматизации, см. его
    # шапку). Провал — провал выкатки: установщик на сайте уже подменён, и
    # молча оставить манифест несобранным значит разъехаться с ним.
    #
    # ADMIN_USER/ADMIN_PASSWORD приезжают тем же путём, что и TELEGRAM_*:
    # окружение сильнее dk.conf, описание цели сильнее обоих.
    if [[ -n "${SELFUPDATE_URL:-}" ]]; then
        [[ -n "${SELFUPDATE_ZIP:-}" ]] || die "в описании есть SELFUPDATE_URL, но нет SELFUPDATE_ZIP — грузить нечего"
        log "загружаю сборку самообновления в админку"
        bash "$KIT_DIR/bin/selfupdate-upload" \
            --url "$SELFUPDATE_URL" --zip "$SELFUPDATE_ZIP" --version "$VERSION" \
            || die "сборка самообновления не уехала — установщик на сайте уже новый, манифест на сервере старый. Повторить: dk deploy $APP"
    fi

    DEPLOY_STATUS=success
    ok "готово: $APP $VERSION"
    exit 0
fi

if (( DRY )); then
    log "упаковка пропущена (dry-run)"
else
    tar -czf "$TARBALL" -C "$ARTIFACT_DIR" .
    ok "артефакт: $(du -h "$TARBALL" | cut -f1)"
fi

# --- предусловия ----------------------------------------------------------
log "проверяю предусловия на сервере"
# Аргументы уезжают через printf %q, как и у nginx-apply.sh с release.sh ниже.
# Ручные одинарные кавычки тут были единственным местом в файле, где значение
# из описания цели попадало в удалённую командную строку как есть: пробел или
# апостроф в APP/ROOT/UNIT разваливал команду на две — вторая выполнялась под
# учёткой с NOPASSWD sudo на скрипты выкатки.
PRE_ARGS=(--app "$APP" --root "$ROOT")
[[ -n "${UNIT:-}" ]] && PRE_ARGS+=(--units "$UNIT")
"${SSH[@]}" "sudo /opt/deploy-kit/preflight.sh $(printf '%q ' "${PRE_ARGS[@]}")" \
    || die "предусловия не выполнены — выкатка не начата"

# --- конфиг nginx ---------------------------------------------------------
#
# Идёт ПОСЛЕ предусловий и ДО выкатки — тем же порядком, что и в пайплайне.
# Порядок не косметика: конфиг применяется с проверкой и откатом (nginx-apply.sh
# снимает бэкап, гоняет nginx -t и возвращает прежний файл при провале), а
# выкатка после него переключает симлинк уже на проверенном сервере.
#
# Источник — сам deploy-kit: NGINX_CONF задаёт путь ВНУТРИ этого репозитория.
# Раньше конфиг мог приехать только из репозитория проекта (входом nginx-conf у
# reusable workflow), а правило гласит обратное — конфигурация nginx живёт
# только здесь. В итоге не работал ни один путь: локальная выкатка про nginx не
# знала вовсе, а в пайплайне проекты вход не передавали, потому что передавать
# было нечего. NGINX_DEST при этом в описаниях целей стоял и выглядел рабочим.
if [[ -n "${NGINX_CONF:-}" ]]; then
    [[ -n "${NGINX_DEST:-}" ]] || die "в описании есть NGINX_CONF, но нет NGINX_DEST — некуда ставить конфиг"

    # Путь обязан быть относительным и не выходить из deploy-kit: файл ставится
    # на сервер под sudo, и произвольная точка ФС здесь недопустима.
    case "$NGINX_CONF" in
        /*|*..*) die "NGINX_CONF должен быть относительным путём внутри deploy-kit, получено: $NGINX_CONF" ;;
    esac
    NGINX_SRC="$KIT_DIR/$NGINX_CONF"
    [[ -f "$NGINX_SRC" ]] || die "нет конфига nginx: $NGINX_SRC"

    remote_tmp
    NGINX_REMOTE="$REMOTE_TMP/${APP}-site.conf"
    NGINX_ARGS=(--app "$APP" --conf "$NGINX_REMOTE" --dest "$NGINX_DEST" --enable)
    (( DRY )) && NGINX_ARGS+=(--dry-run)

    log "конфиг nginx: $NGINX_CONF → $NGINX_DEST"
    "${SCP[@]}" "$NGINX_SRC" "$DEPLOY_USER@$DEPLOY_HOST:$NGINX_REMOTE"
    # Провал здесь — это отказ выкатки целиком: nginx-apply.sh уже вернул файл
    # как было, и катить статику под конфигом, который не встал, незачем.
    "${SSH[@]}" "sudo /opt/deploy-kit/nginx-apply.sh $(printf '%q ' "${NGINX_ARGS[@]}")" \
        || die "конфиг nginx не встал — прежний файл возвращён, выкатка $APP не начата"
    # Отдельный rm не нужен: временный каталог целиком сносит trap на выходе,
    # в том числе когда выкатка падает посередине.
    ok "конфиг nginx применён"
fi

# --- выкатка --------------------------------------------------------------
remote_tmp
REMOTE_ARCHIVE="$REMOTE_TMP/${APP}-${VERSION}.tar.gz"
ARGS=(--app "$APP" --version "$VERSION" --archive "$REMOTE_ARCHIVE" --root "$ROOT" --keep "$KEEP")
[[ -n "${UNIT:-}" ]]        && ARGS+=(--unit "$UNIT")
[[ -n "${HEALTH:-}" ]]      && ARGS+=(--health "$HEALTH")
[[ -n "${VERSION_URL:-}" ]] && ARGS+=(--version-url "$VERSION_URL")
[[ -n "${NEIGHBOURS:-}" ]]  && ARGS+=(--neighbours "$NEIGHBOURS")
[[ -n "${OWNER:-}" ]]       && ARGS+=(--owner "$OWNER")
[[ "${NGINX_RELOAD:-0}" == "1" ]] && ARGS+=(--nginx-reload)
# Цель не раздаёт version.json — шлюз и сверка перейдут на имя релиза в
# симлинке. Без этого флага release.sh потребовал бы от неё того, чего она
# по описанию и не обещает.
[[ "${WRITE_VERSION_FILE:-1}" == "0" ]] && ARGS+=(--no-version-file)
(( ALLOW_SAME )) && ARGS+=(--allow-same-version)
(( DRY )) && ARGS+=(--dry-run)

if ! (( DRY )); then
    log "загружаю артефакт"
    "${SCP[@]}" "$TARBALL" "$DEPLOY_USER@$DEPLOY_HOST:$REMOTE_ARCHIVE"
fi

log "запускаю выкатку на сервере"
# Код 3 — отказ версионного шлюза: прод не тронут, и это не поломка выкатки.
# Различать их обязательно, иначе на месте внятной причины остаётся
# «упало непонятно почему» и следом попытка чинить работающий сервер.
RC=0
"${SSH[@]}" "sudo /opt/deploy-kit/release.sh $(printf '%q ' "${ARGS[@]}")" || RC=$?
if (( RC == 3 )); then
    warn "версия $VERSION не прошла версионный шлюз (см. сообщение выше)"
    die "выкатка $APP отменена шлюзом — прод остался на прежнем релизе"
elif (( RC != 0 )); then
    die "выкатка провалена (код $RC)"
fi

# Архив тоже убирает trap вместе со всем временным каталогом.

DEPLOY_STATUS=success
ok "готово: $APP $VERSION"
