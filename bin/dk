#!/usr/bin/env bash
# dk — одна команда для выкатки всего хозяйства samoy.love.
#
# Цели обнаруживаются сами: каждый файл .deploy-kit/*.env в соседних
# репозиториях — это цель. Ничего регистрировать вручную не нужно.
#
#   dk                      что сейчас на проде
#   dk list                 все цели
#   dk deploy               все цели текущего проекта
#   dk deploy snakes        конкретная цель
#   dk deploy --all         вообще всё
#   dk deploy --dry-run     показать план, ничего не менять
#   dk run                  поднять локально сервисы текущего проекта
#   dk run --list           что вообще запускается локально и на каких портах
#   dk rollback snakes      откатить на предыдущий релиз
#   dk help                 подробности

set -Eeuo pipefail

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; CYA=$'\033[36m'
BLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
# Цвет здесь означает ровно одно — состояние, и ничего больше:
#
#   зелёный/красный  здоровье: ✓/✗, код ответа, состояние юнита, итоги команд
#   жёлтый           предупреждение (warn)
#   голубой          навигация: заголовок раздела, «вы сейчас здесь»
#   тусклый          служебное: шапка таблицы, подсказки, «данных нет» (—)
#   обычный          сами данные — имена целей, версии, пути
#
# Данные не красятся никогда. Иначе одна и та же версия оказывается то серой,
# то белой (по тому, откуда её достали), и таблица выглядит так, будто цвет
# расставлен наугад.
#
# Цвет — только для живого терминала. NO_COLOR — общее соглашение
# (no-color.org), им пользуются, когда вывод уезжает в лог или в чужой парсер.
if [[ ! -t 1 || -n "${NO_COLOR:-}" ]]; then
    RED=''; GRN=''; YEL=''; CYA=''; BLD=''; DIM=''; RST=''
fi
say()  { printf '\n%s%s▸ %s%s\n' "$BLD" "$CYA" "$*" "$RST"; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$RST" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

# Дополнение до ширины колонки. printf считает байты, а не знакоместа, и
# кириллица разносила таблицу: «по таймеру» — 10 символов, но 19 байт, так
# что %-9s не добивал пробелами вовсе. Считаем сами, выбрасывая продолжающие
# байты UTF-8 (0x80–0xBF): что в юникодной локали, что в C остаётся ровно по
# одному байту на символ.
pad() {
    local s="$1" w="$2" t="${1//[$'\x80'-$'\xbf']/}"
    printf '%s%*s' "$s" "$(( w > ${#t} ? w - ${#t} : 0 ))" ''
}

# Значение переменной из файла описания цели.
#
# `|| true` обязателен: при set -Eeuo pipefail отсутствие ключа даёт grep 1,
# pipefail тянет его наружу, и присваивание вроде `root="$(cfg_val ROOT ...)"`
# убивает весь dk молча — без строки, без диагноза. Отсутствие ключа здесь не
# ошибка, а пустое значение: вызывающая сторона сама решает, что с ним делать
# (см. проверку `[[ -n "$root" ]] || continue` ниже, которая иначе недостижима).
cfg_val() { grep -m1 "^$1=" "$2" 2>/dev/null | cut -d= -f2- | tr -d "\"'" || true; }

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECTS_ROOT="${DK_ROOT:-$(dirname "$KIT_DIR")}"

# Настройки доступа. Файл необязателен: переменные окружения имеют приоритет,
# поэтому в CI ничего лишнего не читается.
CONF="${DK_CONF:-$HOME/.config/deploy-kit/dk.conf}"
# Путь к конфигу известен только в рантайме.
if [[ -f "$CONF" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONF"
    set +a
fi

# ------------------------------------------------------------------ поиск целей
#
# Возвращает строки вида: <имя цели>|<каталог проекта>|<файл описания>
#
# LOCAL_ONLY=1 — цель, которой на проде нет вовсе: WPF-клиент собирается под
# Windows и уезжает к пользователю установщиком, а не релизом на сервер. В
# реестре она нужна ради `dk run`, но выкатывать и опрашивать её нечего,
# поэтому по умолчанию из выдачи убирается — иначе `dk` показывал бы её
# вечно красной строкой «нет ответа», а `dk deploy --all` пытался бы катить.
discover() {
    local d f app with_local=0
    [[ "${1:-}" == "--with-local" ]] && with_local=1
    for d in "$PROJECTS_ROOT"/*/; do
        [[ -d "$d/.deploy-kit" ]] || continue
        for f in "$d/.deploy-kit"/*.env; do
            [[ -f "$f" ]] || continue
            app="$(grep -m1 '^APP=' "$f" | cut -d= -f2- | tr -d '"'"'"'')"
            [[ -n "$app" ]] || continue
            (( with_local )) || [[ "$(cfg_val LOCAL_ONLY "$f")" != "1" ]] || continue
            printf '%s|%s|%s\n' "$app" "${d%/}" "$f"
        done
    done
}

# Цели проекта, в котором стоим (если стоим).
current_project() {
    local d="$PWD"
    while [[ "$d" != "/" && "$d" != "." ]]; do
        [[ -d "$d/.deploy-kit" ]] && { echo "$d"; return 0; }
        d="$(dirname "$d")"
    done
    return 1
}

# ------------------------------------------------------------------ команды

cmd_list() {
    say "Цели выкатки"
    local cur=""; cur="$(current_project 2>/dev/null || true)"
    printf '%s  %s %s %s%s\n' "$DIM" \
        "$(pad ЦЕЛЬ 18)" "$(pad ПРОЕКТ 24)" "ОПИСАНИЕ" "$RST"
    discover | while IFS='|' read -r app dir file; do
        # Стрелка — навигация («вы сейчас здесь»), а не состояние: голубая,
        # как и заголовок раздела. Зелёный в этой таблице читался бы как
        # «цель здорова», хотя здоровье тут вообще не проверяется.
        local mark="  "
        [[ -n "$cur" && "$dir" == "$cur" ]] && mark="${CYA}▸ ${RST}"
        printf '%s%s %s %s%s%s\n' "$mark" "$(pad "$app" 18)" \
            "$(pad "$(basename "$dir")" 24)" \
            "$DIM" ".deploy-kit/$(basename "$file")" "$RST"
    done
    echo
    printf '%sСтрелка — цели проекта, в котором вы сейчас.%s\n' "$DIM" "$RST"
}

cmd_status() {
    say "Что сейчас на проде"

    # Список строится из тех же описаний целей, что и выкатка. Раньше здесь был
    # захардкоженный список пяти сайтов: он не знал ни про бота, ни про морду
    # админки, ни про мониторинг — то есть отвечал не на тот вопрос.
    printf '%s  %s %s %s %s%s\n' "$DIM" \
        "$(pad ЦЕЛЬ 18)" "$(pad КОД 4)" "$(pad ЮНИТ 12)" "ВЕРСИЯ" "$RST"

    local -a rows=()
    mapfile -t rows < <(discover)

    # Всё, что нужно с сервера, забираем одним заходом: отдельный ssh на
    # каждый сервис превращает быструю команду в десять рукопожатий. Кроме
    # состояния юнитов спрашиваем, куда указывает current у каждой цели —
    # version.json раздают не все (у Go-сервисов и морды админки его нет),
    # а симлинк есть всегда, и release.sh сверяется ровно с ним.
    local units="" links="" remote="" line app dir file root
    for line in "${rows[@]}"; do
        IFS='|' read -r app dir file <<<"$line"
        root="$(cfg_val ROOT "$file")"
        [[ -n "$root" ]] || continue
        remote+="l=\$(readlink -f $(printf '%q' "$root/current") 2>/dev/null);"
        remote+=" [ -n \"\$l\" ] && printf '%s|%s\\n' $(printf '%q' "$app") \"\$(basename \"\$l\")\";"
    done

    # Без ответа сервера колонка ЮНИТ пуста, а версии остаются только у тех,
    # кто раздаёт version.json. Молча показывать такую таблицу нельзя: она
    # выглядит как «всё выяснили», а на деле половина данных не запрашивалась.
    if [[ -z "${DEPLOY_HOST:-}" || -z "${DEPLOY_KEY:-}" ]]; then
        warn "не заданы DEPLOY_HOST/DEPLOY_KEY: юниты и версии из симлинка недоступны (dk help)"
    else
        local out=""
        out="$(ssh -i "$DEPLOY_KEY" -o ConnectTimeout=8 -o BatchMode=yes \
            "${DEPLOY_USER:-ubuntu}@$DEPLOY_HOST" \
            "systemctl list-units --type=service --type=timer --all --no-legend --plain; \
             echo '#dk#'; $remote true" 2>/dev/null || true)"
        if [[ "$out" == *'#dk#'* ]]; then
            units="${out%%#dk#*}"
            links="${out#*#dk#}"
        else
            warn "$DEPLOY_HOST не ответил по ssh: колонка ЮНИТ и версии из симлинка пусты"
        fi
    fi

    # Цели опрашиваем разом: у каждой до двух curl по десять секунд таймаута,
    # и последовательный обход превращал «быстро посмотреть прод» в полминуты
    # ожидания. Каждая строка пишется в свой файл, печатаются они по порядку —
    # параллельность не должна перетасовывать таблицу.
    local tmp; tmp="$(mktemp -d)"
    local i=0
    for line in "${rows[@]}"; do
        status_row "$line" "$tmp/$i" &
        i=$(( i + 1 ))
    done
    wait

    local j bad=0
    for (( j = 0; j < i; j++ )); do
        cat "$tmp/$j"
        [[ -f "$tmp/$j.bad" ]] && bad=$(( bad + 1 ))
    done
    rm -rf "$tmp"

    echo
    if (( bad )); then
        warn "требуют внимания: $bad из $i"
    else
        ok "все цели в порядке: $i"
    fi

    # Мониторинг раньше стоял здесь отдельной строкой с проверкой «отвечает
    # ли 401»: он жил контейнерами и катился руками, то есть целью выкатки не
    # был. Теперь у него есть .deploy-kit/prod.env, и он приходит из discover
    # наравне со всеми — со своим кодом ответа, юнитом и версией релиза.
    # Отдельная строка означала бы, что мониторинг показан дважды.
}

# Одна строка таблицы: status_row <строка discover> <файл вывода>.
# Рядом с файлом кладёт метку .bad, если цель нездорова — из фонового
# процесса иначе ничего не вернуть.
# Значения units и links видны сюда из cmd_status по области видимости bash.
status_row() {
    # Отсутствие HEALTH или UNIT — нормальное состояние (у бота нет адреса,
    # у сайта нет юнита), а не повод обрывать команду через set -e.
    set +e
    local line="$1" out="$2"
    local app rest file health vurl unit probe code ver state ustate
    local cc uc vc

    app="${line%%|*}"; rest="${line#*|}"; file="${rest#*|}"

    health="$(cfg_val HEALTH "$file")"
    vurl="$(cfg_val VERSION_URL "$file")"
    unit="$(cfg_val UNIT "$file")"

    probe="$health"; [[ -z "$probe" ]] && probe="${vurl%/version.json}"
    code="—"
    if [[ -n "$probe" ]]; then
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$probe" 2>/dev/null)"
        # curl отдаёт 000, когда ответа не было вовсе: не дозвонились, таймаут,
        # сломанный TLS. Три нуля в колонке «КОД» читаются как HTTP-код, а это
        # не он — поэтому говорим словами.
        [[ -z "$code" || "$code" == "000" ]] && code="нет"
    fi

    ver=""
    if [[ -n "$vurl" ]]; then
        ver="$(curl -s --max-time 8 "$vurl" 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    fi
    # Цели без version.json — не «без версии»: показываем релиз, на который
    # смотрит current, как это делает шлюз в release.sh. Источник косвенный,
    # но версия от этого не становится менее настоящей, и красить её иначе
    # значит спрашивать «почему эта строка серая?» на ровном месте.
    vc=""
    [[ -z "$ver" ]] && ver="$(awk -F'|' -v a="$app" '$1==a {print $2; exit}' <<<"$links")"
    # Тусклый здесь — «данных нет», ровно как прочерк в остальных колонках.
    [[ -z "$ver" ]] && { ver="—"; vc="$DIM"; }

    state=""
    if [[ -n "$unit" ]]; then
        state="$(awk -v u="$unit" '$1==u {print $4; exit}' <<<"$units")"
        # Сервис, который запускает таймер, между запусками мёртв по
        # устройству. Красить его красным — учить не верить команде.
        if [[ "$state" == "dead" ]] \
           && [[ -n "$(awk -v u="${unit%.service}.timer" '$1==u {print $1; exit}' <<<"$units")" ]]; then
            state="timer"
        fi
        # Юнит-обёртка (Type=oneshot + RemainAfterExit) отработал и вышел,
        # а поднятое им — работает: у мониторинга это compose со стеком
        # контейнеров. В колонке SUB он навсегда «exited», и без этой ветки
        # исправный стек красился бы красным.
        if [[ "$state" == "exited" ]] \
           && [[ "$(awk -v u="$unit" '$1==u {print $3; exit}' <<<"$units")" == "active" ]]; then
            state="up"
        fi
        [[ -z "$state" ]] && state="none"
    fi

    # systemctl отвечает по-английски, таблица — русская. Раньше в одной
    # колонке соседствовали «running» и «по таймеру».
    case "$state" in
        "")      ustate="—" ;;
        none)    ustate="нет" ;;
        running) ustate="работает" ;;
        up)      ustate="поднят" ;;
        timer)   ustate="по таймеру" ;;
        dead)    ustate="остановлен" ;;
        failed)  ustate="упал" ;;
        exited)  ustate="вышел" ;;
        *)       ustate="$state" ;;
    esac

    # Каждая колонка красится по своему поводу. Раньше состояние юнита
    # перекрашивало код ответа, и «200» светилось красным без объяснений.
    # Здоровье считаем флагами, а не сравнением цветов: при NO_COLOR все
    # последовательности пусты и любое такое сравнение вырождается в истину.
    local code_bad=0 unit_bad=0
    case "$code" in
        200) cc="$GRN" ;;
        —)   cc="$DIM" ;;
        *)   cc="$RED"; code_bad=1 ;;
    esac
    case "$state" in
        "")               uc="$DIM" ;;
        running|up|timer) uc="$GRN" ;;
        *)                uc="$RED"; unit_bad=1 ;;
    esac

    local mark="$GRN✓$RST"
    if (( code_bad || unit_bad )); then
        mark="$RED✗$RST"
        : > "$out.bad"
    fi

    printf '%s %s %s%s%s %s%s%s %s%s%s\n' "$mark" "$(pad "$app" 18)" \
        "$cc" "$(pad "$code" 4)" "$RST" \
        "$uc" "$(pad "$ustate" 12)" "$RST" \
        "$vc" "$ver" "${vc:+$RST}" > "$out"
}

resolve() {
    # По имени цели находит её описание. Имя должно быть уникальным —
    # иначе непонятно, что именно катить, и лучше сказать об этом вслух.
    local want="$1" hits
    hits="$(discover | awk -F'|' -v w="$want" '$1==w')"
    [[ -z "$hits" ]] && die "нет цели «$want». Посмотрите: dk list"
    [[ "$(wc -l <<<"$hits")" -gt 1 ]] && die "цель «$want» встречается в нескольких проектах"
    echo "$hits"
}

cmd_deploy() {
    local all=0 dry=() targets=() pass=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)     all=1; shift ;;
            --dry-run) dry=(--dry-run); shift ;;
            # Обход версионного шлюза — решение осознанное, поэтому флаг
            # доезжает до release.sh как есть, без переименований по дороге.
            --allow-same-version) pass+=(--allow-same-version); shift ;;
            -*)        die "неизвестный флаг: $1" ;;
            *)         targets+=("$1"); shift ;;
        esac
    done

    # «--all и цель» — противоречие: раньше цель молча игнорировалась и уезжало
    # всё хозяйство вместо одного сайта. Такую опечатку лучше не прощать.
    (( all )) && (( ${#targets[@]} )) \
        && die "--all и список целей несовместимы: выберите что-то одно"

    [[ -x "$KIT_DIR/bin/deploy" ]] \
        || die "не найден $KIT_DIR/bin/deploy — проверьте установку deploy-kit"

    local list=()
    if (( all )); then
        mapfile -t list < <(discover)
    elif (( ${#targets[@]} )); then
        local t
        for t in "${targets[@]}"; do list+=("$(resolve "$t")"); done
    else
        # Без аргументов — цели проекта, в котором стоим.
        local cur; cur="$(current_project)" \
            || die "вы не внутри проекта. Укажите цель или используйте --all (dk list)"
        mapfile -t list < <(discover | awk -F'|' -v d="$cur" '$2==d')
        (( ${#list[@]} )) || die "в $(basename "$cur") нет целей выкатки"
    fi

    printf '\n%sБудет выкачено%s%s:%s\n' "$BLD" "$RST" \
        "${dry:+$DIM (сухой прогон)$RST}" "$RST"
    local e; for e in "${list[@]}"; do
        printf '  %s•%s %s\n' "$DIM" "$RST" "${e%%|*}"
    done

    # ПРОГОН — ЭТО ОДНА КОМАНДА ВЛАДЕЛЬЦА, А НЕ ОДНА ЦЕЛЬ.
    #
    # Событие выкатки опознаёт прогон парой полей group/groupSeq
    # (docs/events.md, §6), и локально прообраз группы — момент запуска
    # КОМАНДЫ и её pid. Выставить их обязан именно вызывающий: bin/deploy
    # запускается отдельным процессом на каждую цель, и посчитай он группу у
    # себя, `dk deploy --all` с одиннадцатью целями дал бы одиннадцать групп и
    # одиннадцать сообщений в чате на одну команду.
    #
    # Обе переменные документированы в lib/notify.sh как обязанность bin/dk —
    # и до сих пор не выставлялись здесь ни разу: notify.sh на каждой цели
    # писал «нет DK_RUN_STARTED_MS/DK_RUN_PID» и считал группой один свой
    # вызов. То есть контракт был описан, но не исполнен ни одной стороной.
    #
    # Миллисекунды: %3N есть у GNU date (Linux и Git Bash), у BSD его нет —
    # там он приезжает буквально, и это ловится проверкой, а не уезжает в
    # прообраз строкой «%3N».
    if [[ -z "${DK_RUN_STARTED_MS:-}" ]]; then
        local ms; ms="$(date -u +%s%3N 2>/dev/null || true)"
        [[ "$ms" =~ ^[0-9]{13,}$ ]] || ms="$(( $(date -u +%s) * 1000 ))"
        export DK_RUN_STARTED_MS="$ms"
    fi
    export DK_RUN_PID="${DK_RUN_PID:-$$}"

    local failed=() done_=()
    for e in "${list[@]}"; do
        IFS='|' read -r app dir file <<<"$e"
        say "$app"
        if (cd "$dir" && "$KIT_DIR/bin/deploy" --config "$file" "${dry[@]}" "${pass[@]}" < /dev/null); then
            done_+=("$app")
        else
            failed+=("$app")
            warn "$app: выкатка не прошла"
        fi
    done

    say "Итог"
    (( ${#done_[@]} ))  && ok "успешно: ${done_[*]}"
    if (( ${#failed[@]} )); then
        die "провалено: ${failed[*]}"
    fi
}

# Локальный запуск. Обнаружение целей, разрешение имён и «проект, в котором я
# стою» — те же самые, что у выкатки: второй способ найти цель означал бы, что
# `dk deploy` и `dk run` однажды разойдутся во мнении, что вообще существует.
# Всё остальное — процессы, порты, ветки — живёт в bin/run.
cmd_run() {
    local mode="" pass=() targets=() all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)     all=1; shift ;;
            --list)    mode=list; pass+=(--list); shift ;;
            --dry-run) pass+=(--dry-run); shift ;;
            --force)   pass+=(--force); shift ;;
            --branch)  pass+=(--branch "${2:-}"); shift 2 ;;
            -*)        die "неизвестный флаг: $1" ;;
            *)         targets+=("$1"); shift ;;
        esac
    done

    (( all )) && (( ${#targets[@]} )) \
        && die "--all и список целей несовместимы: выберите что-то одно"

    [[ -x "$KIT_DIR/bin/run" ]] \
        || die "не найден $KIT_DIR/bin/run — проверьте установку deploy-kit"

    # Реестр уезжает в раннер ЦЕЛИКОМ и всегда, включая локальные цели: по
    # нему разрешается RUN_NEEDS, а сосед, которого надо поднять раньше,
    # может не входить в выборку.
    local registry; registry="$(discover --with-local)"
    [[ -n "$registry" ]] || die "не найдено ни одной цели (dk list)"

    local list=()
    if [[ "$mode" == list ]]; then
        # --list отвечает на вопрос «что здесь вообще запускается», а он не
        # про текущий каталог.
        mapfile -t list < <(awk -F'|' '{print $1}' <<<"$registry")
    elif (( all )); then
        mapfile -t list < <(awk -F'|' '{print $1}' <<<"$registry")
    elif (( ${#targets[@]} )); then
        local t
        for t in "${targets[@]}"; do
            awk -F'|' -v w="$t" '$1==w' <<<"$registry" | grep -q . \
                || die "нет цели «$t». Посмотрите: dk run --list"
            list+=("$t")
        done
    else
        local cur; cur="$(current_project)" \
            || die "вы не внутри проекта. Укажите цель или используйте --all (dk run --list)"
        mapfile -t list < <(awk -F'|' -v d="$cur" '$2==d {print $1}' <<<"$registry")
        (( ${#list[@]} )) || die "в $(basename "$cur") нет целей запуска"
    fi

    # Раннер держит терминал до Ctrl-C, и сигнал должен доходить до него, а не
    # до dk: exec отдаёт ему процесс целиком.
    exec "$KIT_DIR/bin/run" "${pass[@]}" "${list[@]}" <<<"$registry"
}

cmd_rollback() {
    local target="${1:-}"; shift || true
    [[ -n "$target" ]] || die "укажите цель: dk rollback <цель> [--list] [--to <версия>]"
    local e; e="$(resolve "$target")"
    IFS='|' read -r app dir file <<<"$e"

    # Файл описания выбирает пользователь — путь известен только в рантайме.
    set -a
    # shellcheck disable=SC1090
    . "$file"
    set +a
    local host="${DEPLOY_HOST:?не задан DEPLOY_HOST}" user="${DEPLOY_USER:-ubuntu}"
    local key="${DEPLOY_KEY:-$HOME/.ssh/id_ed25519}"

    # ROOT здесь — путь на сервере из файла описания.
    local args=(--app "$app" --root "${ROOT:-/opt/$app}")
    [[ -n "${UNIT:-}" ]]   && args+=(--unit "$UNIT")
    [[ -n "${HEALTH:-}" ]] && args+=(--health "$HEALTH")
    [[ "${NGINX_RELOAD:-0}" == "1" ]] && args+=(--nginx-reload)

    # Хвост аргументов уезжает пользовательский (--to <версия>, --list), и
    # квотировать его надо так же, как остальные: без %q версия с пробелом
    # разъезжается на два аргумента уже на той стороне.
    local extra=""
    (( $# )) && extra="$(printf '%q ' "$@")"

    ssh -i "$key" "$user@$host" \
        "sudo /opt/deploy-kit/rollback.sh $(printf '%q ' "${args[@]}")$extra"
}

cmd_help() {
    cat <<'EOF'

dk — выкатка проектов samoy.love одной командой

ИСПОЛЬЗОВАНИЕ
  dk                          что сейчас на проде (коды ответов и версии)
  dk list                     все цели выкатки
  dk deploy                   все цели проекта, в котором вы стоите
  dk deploy <цель> [<цель>…]  выборочно
  dk deploy --all             все цели всех проектов
  dk deploy --dry-run         показать план, ничего не менять
  dk deploy --allow-same-version
                              разрешить повтор уже выкаченной версии
  dk rollback <цель>          откатить на предыдущий релиз
  dk rollback <цель> --list   какие релизы есть на сервере
  dk rollback <цель> --to X   откатить на конкретный релиз
  dk help                     эта справка

ЛОКАЛЬНЫЙ ЗАПУСК
  dk run                      поднять сервисы проекта, в котором вы стоите
  dk run <цель> [<цель>…]     выборочно
  dk run --all                всё, что вообще запускается локально
  dk run --list               что запускается и на каких портах
  dk run --dry-run            план: каталоги, порты, переменные
  dk run --branch main        то же, но на другой ветке — через worktree
  dk run --force              занятый порт освободить, а не отказаться стартовать

ПРИМЕРЫ
  dk deploy                   стоя в MetroMap — выкатит metro
  dk deploy snakes status-site
  dk deploy --all --dry-run   посмотреть, что уедет, ничего не трогая
  dk rollback snakes --list
  dk run metro die-game       две игры рядом, на разных портах
  dk run --branch feat/x      ветка едет в ~/.cache, рабочее дерево не трогается

КАК ЭТО УСТРОЕНО
  Цели обнаруживаются сами: каждый .deploy-kit/*.env в соседних репозиториях —
  это цель. Регистрировать ничего не нужно: добавили файл — появилась цель.

  Локальная выкатка идёт тем же путём, что и CI: один и тот же файл описания
  и один и тот же release.sh на сервере. Расхождения «локально работает, в CI
  нет» быть не может по построению.

  Запуск читает тот же файл описания — ключи RUN_*. Отдельного реестра под
  локальный запуск нет намеренно: два списка целей однажды разойдутся, и
  «добавили файл — появилась цель» перестанет быть правдой. Ключи описаны
  в docs/run.md.

НАСТРОЙКА
  ~/.config/deploy-kit/dk.conf (или переменные окружения):

    DEPLOY_HOST=207.127.93.34
    DEPLOY_USER=ubuntu
    DEPLOY_KEY=/c/Users/…/server access/samoylove-deploy-key

  DK_ROOT — где искать проекты (по умолчанию каталог рядом с deploy-kit).

EOF
}

# ------------------------------------------------------------------ разбор

case "${1:-status}" in
    ""|status)          shift || true; cmd_status ;;
    list|ls)            shift; cmd_list ;;
    deploy|d)           shift; cmd_deploy "$@" ;;
    run|r)              shift; cmd_run "$@" ;;
    rollback|rb)        shift; cmd_rollback "$@" ;;
    help|-h|--help)     cmd_help ;;
    *)                  die "неизвестная команда: $1 (см. dk help)" ;;
esac
