#!/usr/bin/env bash
# Короткий список изменений для сообщения о релизе — ОДИН на все пути выкатки.
#
#   changelog                              последние коммиты (см. «Диапазон»)
#   changelog --since release-20260801-1a2b3c4   от предыдущего релиза
#   changelog --since v1.4.0 --max 6 --width 90
#   changelog --repo ../samoylove --no-header
#   changelog --link-base https://github.com/tr0llex/deploy-kit  со ссылками на PR
#   changelog --since v1.4.0 --all        весь список, для version.json
#                                         (то же, что --max 0 --budget 0)
#
# Печатает в stdout готовый КУСОК сообщения Telegram с parse_mode=HTML:
#
#   <b>Изменения</b>
#   • исправить падение на пустом конфиге
#   • обновить nginx до 1.24
#   …и ещё 12 коммитов
#
# Вызывающая сторона просто дописывает этот кусок к своему тексту. Отдельного
# форматирования у каждого места вызова быть не должно: сообщений о релизе в
# хозяйстве четыре штуки (два workflow, bin/deploy и бот статуса), и как
# только формат разъезжается, читать ленту релизов становится невозможно.
#
# ПОЧЕМУ ЭТО НЕ МОЖЕТ УРОНИТЬ ВЫКАТКУ. Changelog — украшение поверх выкатки.
# Вызов задуман как `CL=$(changelog ...)` в скрипте под `set -Eeuo pipefail`,
# поэтому скрипт ВСЕГДА выходит с кодом 0 и при любой неудаче печатает в
# stdout ровно ничего. Причина неудачи уходит в stderr — молча не пропадает
# ничего: «пусто и непонятно почему» — это ровно тот дефект, из-за которого
# локальные уведомления годом раньше выглядели как «уведомления выключены».
#
# ДИАПАЗОН выбирается сверху вниз, первый сработавший выигрывает:
#
#   0. --live <ревизия> — то, что ПРЯМО СЕЙЧАС РАБОТАЕТ НА ПРОДЕ (поле commit
#      из его version.json). Единственный источник, который не врёт при
#      пропущенной выкатке, — почему это важнее всего остального, ниже.
#   1. --since <ревизия>  — явно переданный предыдущий релиз. Обычно это
#      github.event.before, то есть НАЧАЛО ДИАПАЗОНА ПУША, а не то, что стоит
#      на проде. Принимается и голый sha/тег, и целиком имя версии deploy-kit
#      вида release-20260801-1a2b3c4 — хвостовой sha из него достаётся сам.
#      Если ревизии в этом клоне нет (частый случай на shallow-клоне CI) —
#      переходим к пункту 2, а не выдаём ерунду.
#   2. последний тег, достижимый из HEAD (`git describe --tags --abbrev=0`).
#      Если тег стоит ровно на HEAD (релиз сначала тегают, потом объявляют),
#      берётся предыдущий тег — иначе диапазон был бы пустым.
#   3. последние N коммитов (--depth, по умолчанию 8). Это заведомо не
#      «изменения с прошлого релиза», а «что тут недавно делали», зато всегда
#      что-то осмысленное и всегда ОГРАНИЧЕНО.
#
# ПОЧЕМУ ЖИВОЙ ПРОД ВЫШЕ ДИАПАЗОНА ПУША. GitHub держит в очереди на группу
# concurrency ровно ОДНУ ожидающую задачу: пока катится прогон A и ждёт B, с
# приходом C прогон B ОТМЕНЯЕТСЯ — и cancel-in-progress: false этого не
# меняет, настройки такой нет вовсе. Значит выкатки B не будет, а коммиты B
# останутся в истории между тем, что стоит на проде, и тем, что катит C.
#
# Диапазон «от github.event.before» (то есть от коммита C) их не покрывает: они
# ИСЧЕЗАЮТ ИЗ ЛЕНТЫ НАВСЕГДА — ни один следующий релиз про них уже не
# расскажет, потому что каждый считает свой собственный отрезок пуша. Диапазон
# «от того, что живёт на проде» самовосстанавливается: пропущенный прогон не
# теряет ничего, следующая выкатка объявит и свои коммиты, и его.
#
# ЗАПАСНОЙ ПУТЬ ГРОМКИЙ. Прод может лежать, version.json — не иметь поля
# commit, коммит прода — быть недостижимым в клоне после форс-пуша. Тогда
# работает прежнее поведение (пункт 1 и ниже), но об этом ГОВОРИТСЯ строкой в
# stderr, которую не глушит даже --quiet: тихий откат на худшее поведение и
# есть источник таких дыр. Кто именно сработал, вызывающая сторона узнаёт из
# DK_CHANGELOG_STATUS_FILE и уже сама решает, звать ли это ::warning:: — сам
# генератор про GitHub Actions ничего не знает и знать не должен.
#
# ГЛУБИНА КЛОНА (--deepen). Коммит прода запросто лежит ЗА fetch-depth: 50, с
# которым выкатка делает checkout, — достаточно серии пушей или залежавшегося
# релиза. С --deepen генератор в этом случае доуглубляет историю сам
# (`git fetch --deepen`, затем `--unshallow`), и только потом сдаётся. Флаг
# нужен именно флагом: сеть и правка .git — это не то, что «украшение поверх
# выкатки» имеет право делать без спроса на машине разработчика. Альтернатива
# «fetch-depth: 0 всегда» дороже на КАЖДОМ прогоне ради случая, который
# случается редко.
#
# Неограниченного диапазона нет ни в одной ветке: даже у пунктов 1 и 2 чтение
# истории ограничено сверху (--max-count), а в сообщение попадает не больше
# --max пунктов и не больше --budget СИМВОЛОВ.
#
# СНЯТЫЕ ПРЕДЕЛЫ (--max 0, --budget 0) — ради version.json, а не ради чата.
# Хвост «…и ещё 1 коммит» — худшее из двух: строку занимает, а какой это был
# коммит, не говорит. Убрать его можно ТОЛЬКО здесь: обрезаний по дороге до
# читателя два, и ПЕРВОЕ решает всё. В version.json попадает ровно то, что
# напечатал этот скрипт, и ни бот, ни статус-страница не увидят того, что сюда
# не попало, — как их ни правь. Поэтому есть --max 0 (без предела на число
# пунктов) и --budget 0 (без предела на размер блока): полный список уезжает в
# version.json, а как уложить его в 4096 единиц ОДНОГО сообщения Telegram,
# решает тот, кто отправляет, — РАЗБИВКОЙ НА НЕСКОЛЬКО СООБЩЕНИЙ, а не
# обрезкой. Потерять не должно ничего.
#
# ПОТОЛОК ОСТАЁТСЯ И ПРИ СНЯТЫХ ПРЕДЕЛАХ: 200 пунктов и 20000 видимых
# символов. Это не про красоту сообщения, а про то, что version.json раздаётся
# по HTTP и опрашивается раз в минуту: 20000 кириллических символов — около
# 36 КБ, десятикратный запас к самому большому мыслимому релизу хозяйства
# (десятки коммитов). Патологический вход тут не «сотня коммитов», а «--since
# на первый коммит репозитория» или «--depth 100000»: без потолка в файл
# статуса уехала бы вся история, и он вырос бы на порядки — молча и на каждой
# выкатке. Потолок — единственное, что при снятых пределах ещё может обрезать
# список, и ровно поэтому он честно объявляет об этом хвостом.
#
# ХВОСТ ЗНАЧИТ РОВНО «СПИСОК ОБРЕЗАН ПРЕДЕЛОМ» — и ничего больше. Раньше он
# появлялся и тогда, когда не обрезалось ничего: «всего» считаются все коммиты
# диапазона, включая шум и повторы, поэтому релиз из двух черри-пиков одного
# изменения давал «…и ещё 1 коммит» — про коммит, скрытый НАМЕРЕННО и
# читателю не нужный. Это и есть та строка, на которую пожаловался владелец.
# Теперь хвост печатается, только если пункт действительно не поместился:
# сработал --max, --budget, потолок или окно чтения.
#
# ПОЧЕМУ СИМВОЛЫ, А НЕ БАЙТЫ. Предел на тему придумывается глазами — «строка
# должна читаться с телефона», — а глаз считает буквы. Байтовый предел брал за
# русскую букву двойную плату: 100 байт — это 100 латинских букв, но всего 50
# русских, то есть ровно половину нормы, написанной в CLAUDE.md. По 287
# настоящим темам четырёх репозиториев хозяйства медиана — 50 символов
# (76 байт), максимум — 107 символов (145 байт), и прежний предел в 100 байт
# резал посреди фразы 43 темы из 287, каждую седьмую. Предел в 120 СИМВОЛОВ
# не режет ни одну из измеренных: он снова стал тем, чем задуман, — страховкой
# от аномалии, а не обычным делом.
#
# КАК СЧИТАЮТСЯ СИМВОЛЫ И ПОЧЕМУ НЕ ${#s}. Скрипт работает под LC_ALL=C, и это
# не мелочь, которую можно снять ради счёта (причина — ниже, у самой export).
# Под LC_ALL=C ${#s} считает БАЙТЫ. Значит «посчитать символы» здесь надо
# арифметикой по UTF-8, а не сменой локали: в UTF-8 символ начинается ровно с
# одного байта ВНЕ диапазона 0x80–0xBF, а байты 10xxxxxx — его продолжения.
# Отсюда всё: символов в строке столько, сколько байтов НЕ являются
# продолжением (clen), и рез по границе символа — это рез перед байтом,
# который символ начинает (cut_chars). Такой счёт одинаков на раннере GitHub,
# в Git Bash под Windows и на любой машине с любой локалью.
#
# ПОЭТОМУ НЕ «УПРОЩАЙТЕ» clen ДО ${#s}. Выглядит это как лишний код ровно до
# первой русской темы: под LC_ALL=C ${#s} вернёт вдвое больше, и предел в 120
# символов молча превратится в предел в 60. В тестах на это стоят случаи с
# чистой кириллицей ровно на 120 и 121 символе.
#
# ЛИМИТ TELEGRAM — 4096 единиц UTF-16 на ВСЁ сообщение, а вызывающая сторона
# дописывает свой текст сверху. Счёт с запасом: 8 пунктов по 120
# кириллических символов — 960 единиц, шапка и хвост — около 35, само
# сообщение о выкатке — около 150. Итого около 1150 из 4096, запас
# трёхкратный. Прежний бюджет блока в 1400 БАЙТ при темах до 120 символов
# душил список на четвёртом пункте (кириллический пункт в 120 символов — это
# 242 байта), поэтому бюджет тоже переведён в символы: 1200.
#
# СКВОШ-ХВОСТ «(#NN)». Слияние PR в хозяйстве всегда сквошем: вся ветка
# схлопывается в ОДИН коммит main, тема которого — заголовок PR, а GitHub
# дописывает к ней номер PR. Такой хвост несут 23% тем в истории. В git это
# полезная ссылка, в чате — шум: из сообщения о релизе номер никуда не ведёт,
# а место в строке занимает. Поэтому хвост срезается — но ТОЛЬКО хвост и
# ТОЛЬКО в виде «(#цифры)»: скобки внутри фразы это трогать не должно.
#
# ССЫЛКА НА PR ВМЕСТО СРЕЗАННОГО НОМЕРА (--link-base, по умолчанию ВЫКЛЮЧЕНО).
# Срезать номер целиком — тоже потеря: из чата к обсуждению изменения не
# перейти. Если передать базу — «--link-base https://github.com/tr0llex/deploy-kit»
# — срезанный «(#21)» возвращается в конец пункта уже ссылкой:
#
#   • Завести dependabot одинаково во всех репозиториях <a href="…/pull/21">#21</a>
#
# GitHub переводит /pull/N в /issues/N и обратно, поэтому /pull/N безопасен и
# тогда, когда номер оказался номером issue, а не PR.
#
# БЕЗ --link-base ПОВЕДЕНИЕ ПРЕЖНЕЕ, ДО БАЙТА. Так и задумано: вызывающих у
# скрипта четверо, базу знают не все (её надо вывести из origin или из
# github.repository), и ни один из них не обязан узнать о ссылках сразу.
#
# БАЗА ПРОВЕРЯЕТСЯ, А НЕ ПОДСТАВЛЯЕТСЯ КАК ЕСТЬ. Она приезжает снаружи —
# из настройки цели, из remote, из окружения CI, — а уезжает в HTML-разметку
# сообщения. Принимается только http(s), только из безопасного набора символов
# (кавычки, угловые скобки, пробелы и переводы строк исключены) и не длиннее
# 200 байт. Негодная база — не ошибка и не повод молчать: одна строка в
# stderr, а пункт выдаётся в ПРЕЖНЕЙ форме, без тега. Ронять выкатку из-за
# украшения нельзя, выдавать битую разметку — тем более: Telegram ответит
# ошибкой, curl стоит с `|| true`, и сообщение просто не придёт. Адрес при
# этом ещё и экранируется, включая кавычку: одна кавычка в href рвёт разметку
# ровно так же, как `<` в теме коммита.
#
# ССЫЛКА НЕ ЕСТ ПРЕДЕЛ ДЛИНЫ. Читатель видит «#21» — четыре символа, а не
# сорок символов разметки вокруг них. Поэтому и --width, и --budget считают
# ВИДИМУЮ длину: тема как прежде плюс пробел и «#21». Иначе один и тот же
# релиз со ссылками и без резался бы по-разному, и тема теряла бы смысл ради
# того, чего на экране нет вовсе.
#
# ЗАТО РАЗМЕТКА ЕСТ ЛИМИТ TELEGRAM: 4096 — это единицы СООБЩЕНИЯ, а не
# видимые символы, и теги считаются в него полностью. При восьми пунктах по
# умолчанию это около 350 единиц сверху, запас остаётся трёхкратным. При
# снятых пределах (см. выше) следить за 4096 обязана вызывающая сторона — она
# же и разбивает список на несколько сообщений.
#
# ЭКРАНИРОВАНИЕ. Сообщения уходят с parse_mode=HTML, и один символ `<` в
# теме коммита («поднять go до 1.22 <-- важно») превращает всё сообщение в
# невалидную разметку. Telegram на это отвечает ошибкой, а curl в вызывающем
# коде стоит с `|| true` — сообщение просто не приходит. Поэтому & < >
# экранируются здесь, один раз, и вызывающей стороне про это думать не надо.
#
# АРГУМЕНТЫ И ОКРУЖЕНИЕ (аргумент сильнее переменной):
#
#   --live <рев>    DK_CHANGELOG_LIVE     что стоит на проде прямо сейчас;
#                                         сильнее --since, пусто — не задано
#   --deepen        DK_CHANGELOG_DEEPEN=1 разрешить доуглубление shallow-клона,
#                                         чтобы дотянуться до ревизии прода
#   --since <рев>   DK_CHANGELOG_SINCE    предыдущая ревизия; пусто — не задана
#   --to <рев>      DK_CHANGELOG_TO       до чего считать, по умолчанию HEAD
#   --repo <кат>    DK_CHANGELOG_REPO     где репозиторий, по умолчанию .
#   --max <n>       DK_CHANGELOG_MAX      пунктов, по умолчанию 8;
#                                         0 — без предела (потолок 200)
#   --width <n>     DK_CHANGELOG_WIDTH    длина темы в СИМВОЛАХ, по умолч. 120
#                                         (не в байтах: русская буква — один
#                                         символ, но два байта)
#   --budget <n>    DK_CHANGELOG_BUDGET   весь блок в символах, по умолч. 1200;
#                                         0 — без предела (потолок 20000)
#   --depth <n>     DK_CHANGELOG_DEPTH    запасной вариант, по умолчанию 8
#   --link-base <url> DK_CHANGELOG_LINK_BASE  база ссылки на PR, например
#                                         https://github.com/tr0llex/deploy-kit;
#                                         пусто — номер просто срезается, как
#                                         и раньше
#   --all           —                     снять оба предела: то же самое, что
#                                         --max 0 --budget 0. Именно этим зовут
#                                         генератор все три пути выкатки
#   --no-header     DK_CHANGELOG_HEADER=0 без строки <b>Изменения</b>
#   --quiet         DK_CHANGELOG_QUIET=1  не объяснять происходящее в stderr
#                                         (кроме предупреждений о запасном пути:
#                                         молчать о деградации нельзя)
#                   DK_CHANGELOG_STATUS_FILE  куда записать, ОТ ЧЕГО считался
#                                         диапазон: строка range=live|since|
#                                         tag|depth и строка rev=<ревизия>.
#                                         Флага нет: это не про формат вывода, а
#                                         канал для вызывающего в CI
#
# Мусор в числовых параметрах молча заменяется значением по умолчанию. Ноль —
# мусор везде, кроме --max и --budget, где он значит «без предела».
#
# У девяти флагов из списка значение ОБЯЗАТЕЛЬНО. Вызов вида `changelog --since`
# (флаг последний, значения нет) — негодный: одна строка в stderr, пусто в
# stdout, код 0. Раньше на этом месте был вечный цикл, см. комментарий у
# разбора аргументов. Пустая строка значением считается и заменяется тем же
# значением по умолчанию: `--since ""` — это «переменная не задана», обычный
# способ вызова из скрипта, а не ошибка.

set -uo pipefail

# Единственная железная гарантия: наружу уходит 0 в любом случае. Ловится всё,
# включая необъявленную переменную под set -u и падение git.
# DK_CHANGELOG_STRICT=1 снимает страховку — это нужно только тестам, чтобы
# ошибка в самом скрипте не выглядела как «нет изменений».
[[ "${DK_CHANGELOG_STRICT:-0}" == 1 ]] || trap 'exit 0' EXIT

# Байтовая семантика ${#s} и ${s:0:n}. Нужна не из экономии: без неё длина
# строки зависит от локали машины, и один и тот же коммит обрезался бы на
# раннере и на машине разработчика по-разному. Пределы при этом считаются в
# СИМВОЛАХ — это не противоречие: символы здесь считает clen() арифметикой по
# UTF-8, которой локаль не нужна вовсе (см. шапку). Резать посреди символа
# UTF-8 нельзя (получится битая строка, Telegram её отвергнет) — за этим
# следит cut_chars ниже.
export LC_ALL=C

MAX="${DK_CHANGELOG_MAX:-8}"          # сколько пунктов максимум
WIDTH="${DK_CHANGELOG_WIDTH:-120}"    # длина темы коммита, СИМВОЛОВ
BUDGET="${DK_CHANGELOG_BUDGET:-1200}" # весь блок целиком, СИМВОЛОВ
DEPTH="${DK_CHANGELOG_DEPTH:-8}"      # запасной вариант: последние N коммитов
SINCE="${DK_CHANGELOG_SINCE:-}"
LIVE="${DK_CHANGELOG_LIVE:-}"     # что стоит на проде; сильнее SINCE
DEEPEN="${DK_CHANGELOG_DEEPEN:-0}" # можно ли доуглублять shallow-клон
# Куда сообщить вызывающему, ОТ ЧЕГО считался диапазон. Пусто — не сообщать.
STATUS_FILE="${DK_CHANGELOG_STATUS_FILE:-}"
TO="${DK_CHANGELOG_TO:-HEAD}"
REPO="${DK_CHANGELOG_REPO:-.}"
HEADER="${DK_CHANGELOG_HEADER:-1}"
QUIET="${DK_CHANGELOG_QUIET:-0}"
LINK_BASE="${DK_CHANGELOG_LINK_BASE:-}" # база ссылки на PR; пусто — без ссылок

# Потолки при снятых пределах (--max 0 / --budget 0). Почему именно такие — в
# шапке: version.json раздаётся по HTTP и опрашивается раз в минуту, и расти
# без границы ему нельзя. Числа заданы здесь, чтобы менять их в одном месте.
MAX_CEIL=200      # пунктов
BUDGET_CEIL=20000 # видимых символов в блоке

# РАЗБОР АРГУМЕНТОВ ОБЯЗАН ПРОДВИГАТЬСЯ НА КАЖДОМ ВИТКЕ — ПРИ ЛЮБОМ argv.
#
# Здесь был вечный цикл. Флаги со значением делали `VAR="${2:-}"; shift 2`, и
# на `changelog --since` — то есть когда флаг оказался ПОСЛЕДНИМ в строке —
# оставался ровно один аргумент. Сдвинуть два из одного нельзя: `shift 2`
# возвращает 1 и НЕ СДВИГАЕТ НИЧЕГО. `$#` не менялся, условие цикла держалось,
# и скрипт крутился до таймаута job. Проверено двухминутным зависанием.
#
# Обиднее всего, что защита была снята руками: под `set -u` обращение к `$2`
# при одном аргументе оборвало бы скрипт, а `${2:-}` аккуратно подставил
# пустую строку и оставил цикл без единственного, что его останавливало.
#
# Уронить выкатку changelog не может по построению — но повесить шаг
# уведомления на весь лимит job он мог, а это та же беда с другой стороны:
# «украшение поверх выкатки» превращается в её потолок по времени.
#
# Теперь так: у флага со значением значение ОБЯЗАТЕЛЬНО. Нет второго
# аргумента — это негодный вызов, и обходится он ровно как неизвестный
# аргумент: одна строка объяснения в stderr, пусто в stdout, код 0. Сдвиг
# делается двумя отдельными `shift`: к этому месту уже известно, что
# аргументов не меньше двух, поэтому каждый из них заведомо выполним.
#
# Инвариант, который держит этот цикл: на каждом витке либо `$#` уменьшается
# хотя бы на единицу, либо мы выходим из скрипта. Третьего пути нет ни для
# одного argv — ни для хвостового флага без значения, ни для повторов, ни для
# `--`, ни для одинокого `-`, ни для пустых значений, ни для значения, которое
# само выглядит как флаг (оно съедается как значение, и это тоже продвижение).
while (( $# > 0 )); do
    case "$1" in
        --since|--live|--to|--repo|--max|--width|--budget|--depth|--link-base)
            if (( $# < 2 )); then
                printf 'changelog: у аргумента %s нет значения\n' "$1" >&2
                exit 0
            fi
            # Пустая строка в значении — это «вызывающий передал незаданную
            # переменную», а не ошибка: подставляем то же значение по
            # умолчанию, что и раньше. Мусор в числах разберёт num() ниже.
            case "$1" in
                --since)  SINCE="${2:-}" ;;
                # Пустой --live — обычный случай, а не ошибка: цель может не
                # раздавать version.json, а прод — не ответить вовсе.
                --live)   LIVE="${2:-}" ;;
                --to)     TO="${2:-HEAD}" ;;
                --repo)   REPO="${2:-.}" ;;
                --max)    MAX="${2:-8}" ;;
                --width)  WIDTH="${2:-120}" ;;
                --budget) BUDGET="${2:-1200}" ;;
                --depth)  DEPTH="${2:-8}" ;;
                # Пустая база — это «вызывающий не знает своего origin», самый
                # обычный случай, а не ошибка: ссылок просто не будет.
                --link-base) LINK_BASE="${2:-}" ;;
            esac
            shift; shift ;;
        # --all — то же самое, что «--max 0 --budget 0», одним словом.
        #
        # Алиас заведён не для краткости. Пределы снимают ВСЕ три пути выкатки
        # (bin/deploy и оба переиспользуемых workflow), и вызов у них один и тот
        # же по смыслу: «полный список релиза в version.json». Пока это писалось
        # двумя числами, оба workflow написали его словом --all — и получили
        # ровно то, чем скрипт отвечает на неизвестный аргумент: пустой stdout и
        # код 0. То есть релизы из CI уезжали БЕЗ списка изменений вовсе, молча
        # и на каждой выкатке: пустой блок неотличим от «изменений нет».
        #
        # Значения по-прежнему последнее-выигрывает: «--all --max 5» оставит
        # пять пунктов. Нулями, а не отдельными флагами, — чтобы потолки
        # (MAX_CEIL, BUDGET_CEIL) продолжали действовать ровно как раньше.
        --all)       MAX=0; BUDGET=0; shift ;;
        # Сеть и правка .git — по явному разрешению, а не по догадке. Зовёт
        # флаг только выкатка из CI: там клон одноразовый и shallow, а
        # доуглубление — единственный способ дотянуться до коммита прода.
        --deepen)    DEEPEN=1; shift ;;
        --header)    HEADER=1; shift ;;
        --no-header) HEADER=0; shift ;;
        -q|--quiet)  QUIET=1; shift ;;
        # Диапазон совпадает с шапкой файла: правите шапку — правите число.
        -h|--help)   sed -n '2,236p' "$0"; exit 0 ;;
        # Неизвестный аргумент — не повод ронять выкатку. Скажем в stderr и
        # промолчим в stdout. Сюда же попадают `--` и одинокий `-`: разделителя
        # аргументов у скрипта нет и не было, а выход — это тоже продвижение.
        *) printf 'changelog: неизвестный аргумент: %s\n' "$1" >&2; exit 0 ;;
    esac
done

note() { (( QUIET )) || printf 'changelog: %s\n' "$*" >&2; }

# ПРЕДУПРЕЖДЕНИЕ О ДЕГРАДАЦИИ — НЕ ГЛУШИТСЯ НИЧЕМ, включая --quiet. Молчаливый
# откат на худший диапазон и есть тот дефект, ради которого заведён --live:
# «пусто и непонятно почему» читается как «всё в порядке». --quiet просит не
# объяснять НОРМАЛЬНУЮ работу, а не скрывать, что работа вышла хуже заявленной.
#
# Разметки ::warning:: здесь нет намеренно: генератор зовут четыре места, из
# них в GitHub Actions два. Кто и как объявляет предупреждение своей среде,
# решает вызывающий — по строке range= из DK_CHANGELOG_STATUS_FILE.
warn() { printf 'changelog: ВНИМАНИЕ: %s\n' "$*" >&2; }

# Числовые параметры приходят из окружения и с аргументов — мусор в них не
# должен превращаться в арифметическую ошибку посреди работы.
num() { local v="$1" d="$2"; [[ "$v" =~ ^[0-9]+$ ]] && (( v > 0 )) && printf '%s' "$v" || printf '%s' "$d"; }
# То же самое, но ноль — годное значение. Отдельная функция, а не флаг у num():
# ноль осмыслен ровно у двух параметров из четырёх. У --width ноль означал бы
# пункт из одного многоточия, у --depth — пустой список, и оба тихо испортили
# бы сообщение вместо того, чтобы починиться значением по умолчанию.
num0() { local v="$1" d="$2"; [[ "$v" =~ ^[0-9]+$ ]] && printf '%s' "$v" || printf '%s' "$d"; }
MAX="$(num0 "$MAX" 8)"; WIDTH="$(num "$WIDTH" 120)"
BUDGET="$(num0 "$BUDGET" 1200)"; DEPTH="$(num "$DEPTH" 8)"

# Снятые пределы. Ноль не «ноль пунктов» (пустое сообщение никому не нужно), а
# «предела нет» — но потолок остаётся всегда: и при снятом пределе, и при
# заведомо завышенном значении от вызывающего. Ограничение, которое можно снять
# аргументом, — это не ограничение.
MAX_UNLIM=0; BUDGET_UNLIM=0
(( MAX == 0 )) && { MAX_UNLIM=1; MAX="$MAX_CEIL"; }
(( BUDGET == 0 )) && { BUDGET_UNLIM=1; BUDGET="$BUDGET_CEIL"; }
(( MAX <= MAX_CEIL )) || MAX="$MAX_CEIL"
(( BUDGET <= BUDGET_CEIL )) || BUDGET="$BUDGET_CEIL"

# --- база ссылки на PR ------------------------------------------------------
#
# Проверяется ОДИН раз, здесь, а не при каждом пункте: база у всего вызова одна,
# а проверка — граница доверия, и размазывать её по циклу нельзя.
#
# Набор символов узкий НАМЕРЕННО. В href уезжает чужая строка, и хватит одной
# кавычки, чтобы вырваться из атрибута: `https://x" onmouseover="…`. Telegram
# сам по себе разметку чистит, но полагаться на чужую чистку там, где мы сами
# строим тег, — не наша инженерия. Разрешены схема http(s) и то, что вообще
# бывает в адресе репозитория; кавычки, угловые скобки, обратный слэш, пробелы
# и переводы строк не разрешены, и `$` в конце шаблона у bash значит именно
# конец СТРОКИ ЦЕЛИКОМ, поэтому «хороший адрес, перевод строки, гадость»
# шаблон не проходит.
#
# Регистр схемы только нижний: база приезжает из `git remote get-url` или из
# github.repository, и там он всегда нижний. Угадывать за вызывающего дешевле
# один раз отказаться, чем потом объяснять, почему «HTTPS://» уехало в чат.
LINK_RE='^https?://[A-Za-z0-9][A-Za-z0-9._~%:/@!$&()*+,;=-]*$'
if [[ -n "$LINK_BASE" ]]; then
    # Хвостовые слэши убираем сами: «…/deploy-kit/» и «…/deploy-kit» — одна и
    # та же база, а «//pull/21» в адресе выглядит как опечатка в нашем коде.
    while [[ "$LINK_BASE" == */ ]]; do LINK_BASE="${LINK_BASE%/}"; done
    if (( ${#LINK_BASE} > 200 )); then
        # Разметка не считается в предел длины пункта, но считается в лимит
        # Telegram: база в килобайт умножилась бы на число пунктов.
        note "--link-base длиннее 200 байт — ссылок не будет"
        LINK_BASE=""
    elif [[ ! "$LINK_BASE" =~ $LINK_RE ]]; then
        # В stderr уходит обрезанный кусок: это чужая строка, и лить её в лог
        # выкатки целиком незачем. Пункты при этом остаются прежними.
        note "--link-base не похож на http(s)-адрес — ссылок не будет: «${LINK_BASE:0:60}»"
        LINK_BASE=""
    fi
fi

# --- git -------------------------------------------------------------------
#
# --no-optional-locks: скрипт зовут во время сборки, и обновление индекса
# «заодно» может столкнуться с настоящей сборкой за index.lock.
g() { git --no-optional-locks -C "$REPO" "$@" 2>/dev/null; }

command -v git >/dev/null 2>&1 || { note "нет git — changelog не будет"; exit 0; }
g rev-parse --git-dir >/dev/null || { note "не git-репозиторий: $REPO"; exit 0; }

TO_REV="$(g rev-parse --verify --quiet "${TO}^{commit}")"
[[ -n "$TO_REV" ]] || { note "не разобрать ревизию: $TO"; exit 0; }

# Пустой репозиторий, detached HEAD, shallow — всё это здесь уже пройдено:
# rev-parse выше отработал, значит коммит есть. Имя ветки нигде не нужно
# специально, поэтому detached HEAD ничем не отличается от обычного случая.
[[ "$(g rev-parse --is-shallow-repository)" == "true" ]] && SHALLOW=1 || SHALLOW=0

count_range() {
    local n; n="$(g rev-list --count --no-merges "$@")"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    printf '%s' "$n"
}

# Ревизия из --since. Кроме тега и sha принимается имя версии deploy-kit
# (release-20260801-1a2b3c4 / manual-…): вызывающей стороне удобнее всего
# передать ровно то, что записано в version.json на проде.
resolve_rev() {
    local raw="$1" r
    [[ -n "$raw" ]] || return 1
    r="$(g rev-parse --verify --quiet "${raw}^{commit}")"
    [[ -n "$r" ]] && { printf '%s' "$r"; return 0; }
    if [[ "$raw" =~ ([0-9a-fA-F]{7,40})$ ]]; then
        r="$(g rev-parse --verify --quiet "${BASH_REMATCH[1]}^{commit}")"
        [[ -n "$r" ]] && { printf '%s' "$r"; return 0; }
    fi
    return 1
}

# `git fetch` под сторожем времени. Сторож обязателен по той же причине, по
# которой вызывающие ставят timeout на весь генератор: список изменений —
# украшение поверх выкатки и не имеет права стать её потолком по времени. Сеть
# в CI отвечает не всегда, а `fetch` без предела ждёт столько, сколько дадут.
# Нет timeout(1) (не Linux) — идём без него: --deepen вне CI никто не зовёт.
fetch_deep() { # fetch_deep <аргумент глубины>
    if command -v timeout >/dev/null 2>&1; then
        timeout 60 git --no-optional-locks -C "$REPO" fetch --quiet --no-tags "$1" >/dev/null 2>&1
    else
        git --no-optional-locks -C "$REPO" fetch --quiet --no-tags "$1" >/dev/null 2>&1
    fi
}

# РЕВИЗИЯ, ДО КОТОРОЙ МОЖНО ДОТЯНУТЬСЯ, А НЕ ТОЛЬКО ТА, ЧТО УЖЕ В КЛОНЕ.
#
# Выкатка делает checkout с fetch-depth: 50 — то есть привозит ХВОСТ истории, а
# не всю. Коммит, который стоит на проде, в этот хвост попадает почти всегда, но
# именно «почти»: залежавшийся релиз, серия пушей, откат на старый релиз — и
# объекта в клоне нет. Без доуглубления самый ценный диапазон отваливался бы
# ровно в тех случаях, ради которых он и заведён.
#
# Порядок дешёвого к дорогому: сперва +200 коммитов, и только если не хватило —
# вся история ветки. Обратный порядок платил бы полной историей на каждом
# прогоне, где хватило бы двух сотен.
#
# Попытка ОДНА на весь запуск: после успешного --unshallow клон уже полный, а
# после неудачи (сети нет, remote не отвечает) второй заход стоил бы ещё двух
# минут и ничего не изменил. Флаг переживает вызовы потому, что результат
# возвращается через RESOLVED, а не через stdout: подстановка `$(…)` — это
# подоболочка, и счётчик попыток в ней бы не сохранился.
DEEPEN_TRIED=0
RESOLVED=""
resolve_deep() { # resolve_deep <ревизия> → RESOLVED
    local raw="$1" r step
    RESOLVED=""
    [[ -n "$raw" ]] || return 1
    r="$(resolve_rev "$raw")" && { RESOLVED="$r"; return 0; }
    (( DEEPEN )) || return 1
    # Полный клон доуглублять нечем: объект либо есть, либо недостижим ни от
    # одной ссылки (форс-пуш) — и тогда его не принесёт никакой fetch.
    [[ "$(g rev-parse --is-shallow-repository)" == "true" ]] || return 1
    (( DEEPEN_TRIED )) && return 1
    DEEPEN_TRIED=1
    for step in --deepen=200 --unshallow; do
        note "ревизии «$raw» нет в глубине клона — доуглубляю историю ($step)"
        fetch_deep "$step" || continue
        r="$(resolve_rev "$raw")" && { RESOLVED="$r"; return 0; }
    done
    return 1
}

# --- выбор диапазона -------------------------------------------------------
#
# RANGE — только ревизии, без опций: сколько читать, решает READ_MAX ниже, и
# два источника ограничения в одной команде git разошлись бы при первой правке.
RANGE=(); TOTAL=0; READ_MAX=$(( MAX * 4 )); WHY=""
# Кто из четырёх путей выбора сработал и на какой ревизии остановился. Нужно не
# генератору, а вызывающему: только он знает, чем в его среде объявляют
# деградацию (в GitHub Actions это ::warning::).
STATUS="depth"; STATUS_REV=""
# Окно чтения задано веткой окончательно и подстройке под MAX не подлежит.
# Ставит его только запасной вариант, у которого нет нижней границы диапазона.
READ_HARD=0

pick_range() {
    local rev tag prev
    local shallow_note=""
    (( SHALLOW )) && shallow_note=" (клон shallow)"

    # ЖИВОЙ ПРОД ПЕРВЫМ. Почему он важнее переданного диапазона пуша — в шапке
    # файла: отменённый очередью concurrency прогон не теряет свои коммиты
    # только при этом отсчёте.
    if [[ -n "$LIVE" ]]; then
        if resolve_deep "$LIVE"; then
            rev="$RESOLVED"
            RANGE=("$rev..$TO_REV"); TOTAL="$(count_range "$rev..$TO_REV")"
            WHY="от того, что стоит на проде ($LIVE)"
            STATUS="live"; STATUS_REV="$rev"
            return 0
        fi
        # Громко, а не note: дальше работает прежнее поведение, которое теряет
        # коммиты пропущенных прогонов, и знать об этом обязан читатель лога.
        warn "коммита прода «$LIVE» нет в этом клоне$shallow_note — считаю запасным путём; коммиты прогона, отменённого очередью, в список НЕ попадут"
    fi

    if [[ -n "$SINCE" ]]; then
        if resolve_deep "$SINCE"; then
            rev="$RESOLVED"
            RANGE=("$rev..$TO_REV"); TOTAL="$(count_range "$rev..$TO_REV")"
            WHY="от переданной ревизии $SINCE"
            STATUS="since"; STATUS_REV="$rev"
            return 0
        fi
        # Самая частая причина — actions/checkout с fetch-depth: 1: объекта
        # прошлого релиза в клоне просто нет. Это не ошибка вызывающего, идём
        # дальше по списку.
        note "ревизии «$SINCE» нет в этом клоне$shallow_note — пробую тег"
    fi

    tag="$(g describe --tags --abbrev=0 "$TO_REV")"
    if [[ -n "$tag" ]]; then
        # Тег ровно на HEAD: релиз сначала тегают, потом объявляют, и диапазон
        # tag..HEAD оказался бы пуст. Берём предыдущий тег.
        if [[ "$(g rev-parse --verify --quiet "${tag}^{commit}")" == "$TO_REV" ]]; then
            prev="$(g describe --tags --abbrev=0 "${tag}^")"
            if [[ -n "$prev" ]]; then
                RANGE=("$prev..$TO_REV"); TOTAL="$(count_range "$prev..$TO_REV")"
                WHY="от предыдущего тега $prev (тег $tag стоит на HEAD)"
                STATUS="tag"; STATUS_REV="$prev"
                return 0
            fi
        else
            RANGE=("$tag..$TO_REV"); TOTAL="$(count_range "$tag..$TO_REV")"
            WHY="от последнего тега $tag"
            STATUS="tag"; STATUS_REV="$tag"
            return 0
        fi
    fi

    # Запасной вариант. Ограничение жёсткое: читаем ровно DEPTH коммитов и
    # столько же считаем «всеми» — иначе «…и ещё 900 коммитов» соврало бы про
    # релиз, в котором изменений было три.
    #
    # READ_HARD=1 — потому что «жёсткое» здесь раньше жёстким не было. Ниже
    # окно чтения подтягивается под потолок пунктов, и при --all (MAX=0 →
    # MAX_CEIL) DEPTH молча превращался в 201. У этой ветки нижней границы
    # диапазона нет вовсе — RANGE это просто HEAD, — так что окно и есть
    # единственный предел: релиз выкатки, запущенной не пушем, увозил в
    # version.json ВСЮ историю репозитория. Ровно так в сообщении о релизе
    # status.samoy.love оказались шесть десятков чужих правок, включая
    # служебные «probe: …» полугодовой давности.
    #
    # Считанное и посчитанное обязаны совпадать: TOTAL здесь тоже DEPTH, и
    # разъехавшись, они дали бы «показано 60 из 8».
    RANGE=("$TO_REV")
    TOTAL="$(count_range --max-count="$DEPTH" "$TO_REV")"
    READ_MAX="$DEPTH"
    READ_HARD=1
    WHY="тегов нет и предыдущая ревизия не передана — последние $DEPTH коммитов"
    STATUS="depth"; STATUS_REV="$TO_REV"
    return 0
}
pick_range

# Отчёт о выбранном пути — ДО всех выходов ниже. Диапазон уже выбран, и «показывать
# нечего» (прод стоит ровно на HEAD) для вызывающего такой же законный ответ, как
# и список: молчание он был бы вынужден трактовать как отказ. Ошибка записи не
# значит ничего для выкатки, поэтому и не проверяется: файл — канал сведений, а
# не условие работы.
if [[ -n "$STATUS_FILE" ]]; then
    printf 'range=%s\nrev=%s\n' "$STATUS" "$STATUS_REV" > "$STATUS_FILE" 2>/dev/null
fi

(( TOTAL > 0 )) || { note "нечего показывать ($WHY)"; exit 0; }
# Читаем с запасом на отфильтрованный шум, но всегда конечное число. Верхняя
# граница окна привязана к потолку пунктов (четырёхкратный запас — тот же, что
# и у обычного случая): при --max 0 показать 200 пунктов из окна в 200 строк не
# вышло бы, стоило истории содержать хоть один подъём версии.
#
# READ_HARD снимает эту подстройку: у диапазона без нижней границы окно чтения
# и есть единственный предел, и расширять его «с запасом на отфильтрованный
# шум» означает увозить в релиз всю историю.
if (( ! READ_HARD )); then
    (( READ_MAX >= MAX + 1 )) || READ_MAX=$(( MAX + 1 ))
    (( READ_MAX <= MAX_CEIL * 4 )) || READ_MAX=$(( MAX_CEIL * 4 ))
fi

# --- отбор и оформление ----------------------------------------------------

# Шум. Слияния отсекает сам git (--no-merges), здесь — то, что слиянием не
# является, но и изменением тоже: автосквош-заготовки, WIP, чистые подъёмы
# версии, работа dependabot. Читают это с телефона, и каждая такая строка
# вытесняет настоящую.
#
# ПОЧЕМУ ЭТОТ СПИСОК ИМЕННО ТАКОЙ. Он не придуман, а снят с настоящей истории
# четырёх репозиториев хозяйства (deploy-kit, Snakes, MetroMap, samoy.love):
# 371 коммит, из них 20 — `deps: bump …`, один — `build(deps): bump …`, ещё
# десятки слияний. В захваченном выводе на deploy-kit пять пунктов из восьми
# были подъёмами версий actions — настоящие изменения из сообщения вытеснял
# бот, и релиз читался как «мы весь спринт обновляли actions/checkout».
#
# ПЕРЕФИЛЬТРОВАТЬ ХУЖЕ, ЧЕМ НЕДОФИЛЬТРОВАТЬ. Лишний пункт видно, пропавший —
# нет. Поэтому каждый шаблон здесь узкий и привязан к НАЧАЛУ темы, а в той же
# истории есть живые коммиты, которые широкий шаблон убил бы молча:
#
#   «Track tools manifest, bump jsdom to 30»          — bump НЕ в начале
#   «dependabot.yml привести к формату prettier»      — про настройку бота
#   «Завести dependabot одинаково во всех репозиториях»
#   «chore: удалить мёртвый код — типы, функции и 22 класса CSS»
#   «Вернуть прежнее имя service worker как надгробие» — не Revert
#   «Не пускать релиз без версии и без роста версии»   — не подъём версии
#   «Partial: prod nginx config, … cosmetics WIP»      — WIP не в начале
#
# Все они этот фильтр проходят, и так и должно быть.

# Автосквош-заготовки и WIP.
NOISE_RE='^(fixup|squash|amend)!'
NOISE_RE+='|^[Ww][Ii][Pp]([[:space:]:,.!-]|$)'

# Слияния — только в тех формах, которые порождает сам git, плюс «Merge X into
# Y» от `git merge` без --no-ff. Широкого `^Merge ` тут нет намеренно: он убил
# бы осмысленное «Merge duplicate CSS classes».
NOISE_RE+='|^Merge (branch|tag|commit|pull request|remote-tracking branch) '
NOISE_RE+='|^Merge [^[:space:]]+ into [^[:space:]]+$'
NOISE_RE+='|^(Мерж|Слить) ветк'

# Откат СЛИЯНИЯ и откат отката — служебные. Простой `Revert "…"` тут НЕ
# ловится: отмена изменения — это тоже изменение, и читателю релиза она важнее
# многого другого.
NOISE_RE+='|^Revert "(Merge |Revert ")'

# Dependabot. Форма темы зависит от настройки prefix, в хозяйстве встречаются
# три: голая («Bump actions/checkout from 4 to 5», формат по умолчанию),
# `deps: bump …` (так настроено в .github/dependabot.yml) и `build(deps):
# bump …` (conventional commits, MetroMap). Общее у всех — слово bump в самом
# начале темы, поэтому именно к началу шаблон и привязан.
NOISE_RE+='|^[Bb]ump '
NOISE_RE+='|^(deps|deps-dev|build|chore|ci|fix)(\((deps|deps-dev)\))?: [Bb]ump '

# Чистые подъёмы версии — тема, в которой нет ничего, кроме самой версии.
NOISE_RE+='|^chore\(release\)'
NOISE_RE+='|^[Rr]elease v?[0-9]'
NOISE_RE+='|^v?[0-9]+\.[0-9]+(\.[0-9]+)?([-+][0-9A-Za-z.]+)?[[:space:]]*$'
NOISE_RE+='|^(Версия|версия) v?[0-9]'
# Русские подъёмы версии. Хвост «до 1.0.0-rc.2» разрешён, а любой другой —
# нет: «Не пускать релиз без версии и без роста версии» обязано остаться.
# Регистр перечислен алтернативой, а не классом [Пп]: скрипт работает под
# LC_ALL=C, и класс из кириллицы там разбирается по БАЙТАМ, то есть значит
# совсем не то, что написано.
NOISE_RE+='|^(Поднять|поднять|Обновить|обновить|Проставить|проставить) версию([[:space:]]+до[[:space:]]+v?[0-9][0-9A-Za-z.+-]*)?[[:space:]]*$'
is_noise() {
    local s="$1"
    [[ -z "$s" ]] && return 0
    [[ "$s" =~ $NOISE_RE ]] && return 0
    return 1
}

# Длина в СИМВОЛАХ — без единой оглядки на локаль. В UTF-8 байты 0x80–0xBF
# (10xxxxxx) — продолжения символа, все остальные символ начинают. Значит
# символов ровно столько, сколько байтов НЕ являются продолжением: выбрасываем
# продолжения и меряем оставшееся.
#
# ${#s} ЗДЕСЬ НЕ ГОДИТСЯ — под LC_ALL=C это байты, и на русской теме предел в
# 120 символов молча стал бы пределом в 60. Менять локаль ради счёта тоже
# нельзя: она стоит здесь именно затем, чтобы обрезка была одинаковой на
# раннере и в Git Bash. Подробно — в шапке файла.
#
# Диапазон в скобках БАЙТОВЫЙ и разбирается по байтам — по той же причине, по
# которой ниже, в фильтре шума, нельзя написать кириллический класс [Пп].
# Один и тот же механизм: там он мешает, здесь работает на нас.
clen() { local t="${1//[$'\x80'-$'\xbf']/}"; printf '%s' "${#t}"; }

# Обрезка по СИМВОЛАМ и НИКОГДА не посреди символа UTF-8. Битая строка в UTF-8
# — это отказ Telegram, то есть молча не пришедшее сообщение.
cut_chars() {
    local s="$1" n="$2" t w i v cnt cut
    (( $(clen "$s") <= n )) && { printf '%s' "$s"; return 0; }
    # Многоточие тоже занимает место — при счёте в символах ровно один символ,
    # а не три байта, как было при байтовом. Результат обязан укладываться в
    # заявленный предел вместе с ним. Нижняя граница (предел меньше пяти)
    # оставлена как была: лучше выдать четыре символа, чем одно многоточие.
    (( n = n > 4 ? n - 1 : 3 ))
    # Рез ищется тем же правилом, что и счёт: идём по байтам и считаем начала
    # символов. Останавливаемся ровно перед (n+1)-м началом, поэтому точка
    # реза лежит на границе символа ПО ПОСТРОЕНИЮ — отматывать назад после
    # неудачного реза, как делала прежняя байтовая версия, больше нечего.
    cnt=0; cut=${#s}
    for (( i = 0; i < ${#s}; i++ )); do
        printf -v v '%d' "'${s:i:1}"
        # На части сборок bash char знаковый, и байт 0xD0 приезжает как -48.
        (( v < 0 )) && v=$(( v + 256 ))
        if (( v < 128 || v >= 192 )); then
            (( cnt == n )) && { cut=$i; break; }
            cnt=$(( cnt + 1 ))
        fi
    done
    t="${s:0:cut}"
    # Обрыв на середине слова читается хуже, чем чуть более короткая строка.
    # Граница слова — пробел, то есть ASCII: символ UTF-8 этим не разрезать.
    if [[ "$t" == *" "* ]]; then
        w="${t% *}"
        (( $(clen "$w") * 2 >= n )) && t="$w"
    fi
    while [[ "$t" == *" " ]]; do t="${t% }"; done
    printf '%s…' "$t"
}

# Экранирование делает sed, а не подстановка ${s//&/&amp;}.
#
# В bash 5.2 символ `&` в СТРОКЕ ЗАМЕНЫ стал значить «то, что совпало» — как в
# sed. Из-за этого `${s//</&lt;}` на новых bash даёт `<lt;` вместо `&lt;`, а на
# старых — правильный результат. Разница между раннером и машиной
# разработчика тут недопустима вдвойне: сломанная разметка не видна в логе,
# Telegram просто отвечает ошибкой, а curl стоит с `|| true`.
esc_html() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# То же для ЗНАЧЕНИЯ АТРИБУТА. Отличие ровно одно и оно принципиальное: в
# тексте кавычка безобидна, а в href она закрывает атрибут. Экранируется даже
# то, что уже отсеяла проверка базы выше: проверка и экранирование защищают от
# разного (проверка — от «это вообще не адрес», экранирование — от «адрес, но
# с амперсандом»), и держаться должны независимо друг от друга. `&` в СТРОКЕ
# ЗАМЕНЫ sed значит «совпавшее», поэтому он экранирован обратным слэшем — та
# же ловушка, что описана у esc_html.
esc_attr() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

# Объявление и присваивание раздельно НЕ для красоты: под `set -u`
# `local n="$1" h="$(( n % 100 ))"` падает с «n: unbound variable» — внутри
# одного local переменная ещё не видна.
plural() {
    local n="$1" h t
    h=$(( n % 100 )); t=$(( n % 10 ))
    if (( h >= 11 && h <= 14 )); then printf 'коммитов'
    elif (( t == 1 )); then printf 'коммит'
    elif (( t >= 2 && t <= 4 )); then printf 'коммита'
    else printf 'коммитов'; fi
}

OUT=""; SHOWN=0
# VIS — длина уже набранного блока в ВИДИМЫХ символах. Без ссылок она равна
# длине OUT символ в символ, поэтому прежние вычисления бюджета не меняются
# ни на единицу; со ссылками разметка в неё не входит (почему — в шапке).
VIS=0
# READ_N — сколько тем прочитано из git, СЧИТАЯ шум. Нужно только для одного
# вопроса: упёрлись ли мы в окно чтения. Если упёрлись, а в диапазоне коммитов
# больше, значит список действительно обрезан, и об этом надо сказать.
READ_N=0
# CUT — «список обрезан пределом». Единственное основание для хвоста «…и ещё».
# Раньше хвост выводился по разнице «всего минус показано», а она растёт и от
# отфильтрованного шума, и от свёрнутых повторов — то есть от того, что скрыто
# намеренно. Отсюда и брались «…и ещё 1 коммит» на релизе, где не потерялось
# ничего.
CUT=0
[[ "$HEADER" == 1 ]] && HEAD_LINE="<b>Изменения</b>" || HEAD_LINE=""
# Место под хвост «…и ещё 123 коммита» резервируется заранее: дописывать его
# в уже израсходованный бюджет было бы враньём про лимит. Сорок СИМВОЛОВ —
# запас вдвое: самый длинный вообразимый хвост («…и ещё 12345 коммитов») —
# двадцать один символ.
RESERVE=40

# add_line <строка> [видимая длина]
#
# Второй аргумент — длина того, что УВИДИТ читатель. Не задан — считаем по
# самой строке, как и раньше: у шапки и у хвоста разметки со скрытой длиной
# нет. VIS повторяет прежнюю арифметику clen("$OUT") ровно, включая то, что у
# первого пункта без шапки перевода строки перед ним нет.
add_line() {
    local vis="${2:-}"
    [[ -n "$vis" ]] || vis="$(clen "$1")"
    if [[ -n "$OUT" ]]; then OUT="$OUT"$'\n'"$1"; VIS=$(( VIS + 1 + vis ))
    else OUT="$1"; VIS="$vis"; fi
}
[[ -n "$HEAD_LINE" ]] && add_line "$HEAD_LINE"

declare -A SEEN=()
while IFS= read -r -d '' subj || [[ -n "${subj:-}" ]]; do
    READ_N=$(( READ_N + 1 ))
    # Тема может прийти многострочной, если в сообщении нет пустой строки
    # после первой. В пункт списка это не годится — склеиваем в одну строку.
    subj="${subj//$'\r'/ }"; subj="${subj//$'\n'/ }"; subj="${subj//$'\t'/ }"
    while [[ "$subj" == *"  "* ]]; do subj="${subj//  / }"; done
    subj="${subj#"${subj%%[![:space:]]*}"}"; subj="${subj%"${subj##*[![:space:]]}"}"

    is_noise "$subj" && continue

    # Сквош-хвост «(#NN)», который дописывает GitHub при слиянии PR. Почему он
    # тут вообще есть и почему в чате он лишний — в шапке файла.
    #
    # ШАБЛОН НАРОЧНО УЗКИЙ: только в самом конце темы, только «(#цифры)» и
    # только после пробела. Широкий («убрать любые скобки», «убрать всё после
    # решётки») съел бы куски живых тем из истории хозяйства:
    #
    #   «Убрать (временный) обход бага в разборе конфига»  — скобки во фразе
    #   «Привести схему к официальной версии 6.1 (см. #16)» — ссылка в тексте
    #   «Поправить (#12) в шаблоне письма»                  — не хвост
    #   «Не трогать хвост без решётки (2026)»               — цифры без #
    #
    # Перед хвостом обязано остаться хоть что-то непробельное: тема из одного
    # «(#12)» странная, но пустой пункт списка хуже неё.
    #
    # Срезается ДО подсчёта длины и до свёртки повторов — оба про то, что
    # увидит читатель. Заодно два черри-пика одного изменения с разными
    # номерами PR сворачиваются в один пункт, как и должны.
    #
    # Номер запоминается отдельно: с --link-base он вернётся в конец пункта
    # ссылкой, без --link-base — не вернётся никак. Из ТЕМЫ он уходит в обоих
    # случаях, и это важно для двух вещей ниже: длина считается по теме без
    # номера, а два черри-пика одного изменения с разными номерами PR
    # по-прежнему сворачиваются в один пункт.
    pr=""
    if [[ "$subj" =~ ^(.*[^[:space:]])[[:space:]]+\(#([0-9]+)\)$ ]]; then
        subj="${BASH_REMATCH[1]}"; pr="${BASH_REMATCH[2]}"
    fi

    # Повтор темы (черри-пик, «то же самое в другой ветке») читателю ничего не
    # добавляет. Индекс в кавычках: тема коммита — чужой текст, и скобка или
    # `$(…)` внутри неё не должны попасть в разбор индекса массива.
    [[ -n "${SEEN["$subj"]:-}" ]] && continue
    SEEN["$subj"]=1

    (( SHOWN < MAX )) || { CUT=1; break; }
    line="• $(esc_html "$(cut_chars "$subj" "$WIDTH")")"
    # Видимая длина пункта. Пока ссылки нет — это длина самой строки, как и
    # раньше, символ в символ.
    vis="$(clen "$line")"
    if [[ -n "$LINK_BASE" && -n "$pr" ]]; then
        # /pull/N выбран сознательно: GitHub переводит его в /issues/N, когда
        # номер оказался номером issue, а обратного перевода нет.
        line="$line <a href=\"$(esc_attr "$LINK_BASE/pull/$pr")\">#$pr</a>"
        # Видно из этого ровно « #21»: пробел, решётка и цифры. Цифры — ASCII,
        # поэтому байт здесь равен символу.
        vis=$(( vis + 2 + ${#pr} ))
    fi
    # Бюджет блока — тоже в символах, поэтому и здесь clen, а не ${#…}.
    (( VIS + 1 + vis + RESERVE <= BUDGET )) || { CUT=1; break; }
    add_line "$line" "$vis"
    SHOWN=$(( SHOWN + 1 ))
done < <(g log -z --no-merges --format='%s' --max-count="$READ_MAX" "${RANGE[@]}")

(( SHOWN > 0 )) || { note "все коммиты диапазона отфильтрованы как шум ($WHY)"; exit 0; }

# Окно чтения — третий предел наравне с --max и --budget: если оно исчерпано, а
# в диапазоне коммитов больше, за окном осталось непрочитанное, и молчать об
# этом нельзя.
(( READ_N >= READ_MAX && TOTAL > READ_N )) && CUT=1

# Хвост — только если пункт действительно не поместился. «Всего минус
# показано» в одиночку основанием не является: разницу дают ещё и шум, и
# свёрнутые повторы, то есть скрытое НАМЕРЕННО. Ровно на этом и появлялось
# «…и ещё 1 коммит», из которого читателю не понять, какой именно коммит от
# него спрятали, — а при снятых пределах не спрятан вообще ни один.
REST=$(( TOTAL - SHOWN ))
(( CUT && REST > 0 )) && add_line "…и ещё $REST $(plural "$REST")"

LIM="макс $MAX"; (( MAX_UNLIM )) && LIM="без предела, потолок $MAX_CEIL"
LIM="$LIM, бюджет $BUDGET"; (( BUDGET_UNLIM )) && LIM="$LIM (снят, потолок $BUDGET_CEIL)"
note "$WHY: показано $SHOWN из $TOTAL ($LIM), $(clen "$OUT") символов разметки, $VIS видимых (${#OUT} байт)"
printf '%s\n' "$OUT"
exit 0
