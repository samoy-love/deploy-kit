#!/usr/bin/env bash
# Загрузка сборки самообновления лаунчера в админку.
#
#   selfupdate-upload --url https://launcher.samoy.love/admin/api \
#                     --zip scripts/generated_downloads/ChillHub-launcher-payload.zip \
#                     --version 1.2.3
#
# Что делает: входит в админку (POST /auth/login, cookie-сессия) и публикует
# ZIP полезной нагрузки (POST /upload) — сервер распаковывает архив и строит
# манифест content/manifests/launcher/<версия>.json.
#
# ЧЕГО НЕ ДЕЛАЕТ — НАМЕРЕННО: latest.json не переключается никогда
# (updateLatest=0 зашит, а не параметризован). Выложенная версия лежит на
# сервере неактивной, пока человек не переключит «latest» в админке руками.
# Это граница автоматизации, заданная владельцем: выкатка довозит сборку,
# а решение «теперь обновляемся на неё» принимает человек.
#
# Учётные данные приходят ТОЛЬКО окружением: ADMIN_USER и ADMIN_PASSWORD.
# В CI это секреты репозитория, на машине разработчика — dk.conf. Ни в
# аргументах (видны в ps), ни в выводе (утекут в лог прогона) им не место;
# в URL, которые печатаются, их не бывает.
#
# Зовут его двое, и это причина существования файла:
#   * .github/workflows/desktop-artifact.yml — шагом после публикации
#     установщика (скачивает скрипт с main, как bin/changelog);
#   * bin/deploy (режим PUBLISH_DEST) — после publish-file.sh.
#
# Код возврата: 0 — сборка на сервере, 1 — нет. Провал загрузки — провал
# выкатки установщика: exe на сайте уже подменён, и молча оставить манифест
# несобранным значит разъехаться с ним навсегда.

set -Eeuo pipefail

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'
[[ -t 1 ]] || { RED=''; GRN=''; YEL=''; DIM=''; RST=''; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$RST" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

URL=""; ZIP=""; VER=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --url)     URL="$2"; shift 2 ;;
        --zip)     ZIP="$2"; shift 2 ;;
        --version) VER="$2"; shift 2 ;;
        *) die "неизвестный аргумент: $1 (см. шапку файла)" ;;
    esac
done

[[ -n "$URL" ]] || die "нужен --url (база админ-API, например https://launcher.samoy.love/admin/api)"
[[ -n "$ZIP" ]] || die "нужен --zip"
[[ -n "$VER" ]] || die "нужен --version"
[[ -f "$ZIP" ]] || die "нет файла $ZIP — сборка не сделала ZIP самообновления?"
[[ -s "$ZIP" ]] || die "файл $ZIP пуст"
URL="${URL%/}"

# Версия уезжает в имя манифеста на сервере; сервер проверяет её сам
# (IsSafeVersion), но падать лучше здесь, до логина и до загрузки мегабайтов.
[[ "$VER" =~ ^[A-Za-z0-9._-]+$ ]] || die "версия «$VER» не похожа на версию"

[[ -n "${ADMIN_USER:-}" && -n "${ADMIN_PASSWORD:-}" ]] || die "нет ADMIN_USER/ADMIN_PASSWORD в окружении.
   CI: задайте секреты репозитория. Локально: добавьте обе строки в ~/.config/deploy-kit/dk.conf"

command -v curl >/dev/null 2>&1 || die "нет curl"

# ПУТИ ДЛЯ curl — ЧЕРЕЗ cygpath, ГДЕ ОН ЕСТЬ. Под Windows curl нативный:
# POSIX-путь от mktemp (/tmp/…) он не понимает — «Failed to open/read local
# data from file» на -F и молча не тот файл на -c/-b. cygpath -m даёт форму
# C:/…, которую нативный curl читает; на Linux cygpath'а нет, путь идёт как
# есть. Конвертируется ВСЁ, что curl открывает сам: архив, cookie-файл.
native_path() {
    if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi
}

# Cookie-сессия живёт в файле 0600 из mktemp и убирается ловушкой: токен
# сессии — тот же секрет, что и пароль, и переживать скрипт ему незачем.
JAR="$(mktemp -t dk-admin-XXXXXX)"
trap 'rm -f "$JAR"' EXIT
JAR_C="$(native_path "$JAR")"
ZIP_C="$(native_path "$ZIP")"

# Учётные данные уезжают JSON-телом ЧЕРЕЗ STDIN, а не аргументами curl и не
# файлом. Причина та же, что у `text@-` в tg_send (см. bin/deploy): под
# Windows curl — нативный бинарь, его argv перекодируется в системную кодовую
# страницу, и любой не-ASCII символ в пароле доехал бы искажённым — как
# «неверный пароль», по которому не понять, что сломалась кодировка, а не
# учётка. Файл не годится там же: POSIX-путь от mktemp нативный curl не
# понимает вовсе. stdin идёт байтами мимо обеих мин.
#
# Экранируются ровно два символа, которые JSON-строка не терпит сырыми из
# этого набора: \ и ". Управляющих символов в пароле не бывает не по вере в
# лучшее, а потому, что такой пароль нельзя было бы и задать этим же путём.
json_str() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# -f превращает 401 в ненулевой код; тело ответа при этом не печатается —
# и не должно: в нём нечего читать, а причина и так одна из двух.
if ! printf '{"username":"%s","password":"%s"}' \
        "$(json_str "$ADMIN_USER")" "$(json_str "$ADMIN_PASSWORD")" \
    | curl -fsS --max-time 30 -c "$JAR_C" -o /dev/null \
        -H 'Content-Type: application/json' \
        --data-binary @- \
        "$URL/auth/login"; then
    die "логин в админку не прошёл ($URL/auth/login): неверные ADMIN_USER/ADMIN_PASSWORD либо админка недоступна"
fi

# Мутирующие запросы админка принимает только с заголовком X-CSRF-Token,
# равным cookie csrf_token из логина (double-submit, см. auth.go). Токен —
# ASCII из генератора, через argv едет без потерь.
CSRF="$(awk '$6 == "csrf_token" {v=$7} END {print v}' "$JAR")"
[[ -n "$CSRF" ]] || die "логин прошёл, но cookie csrf_token в сессии нет — контракт админки изменился?"

SIZE="$(du -h -- "$ZIP" | cut -f1)"
printf '%s[%s]%s загружаю сборку %s (%s) в админку\n' "$DIM" "$(date -u -d '+3 hours' '+%H:%M:%S' 2>/dev/null || date '+%H:%M:%S')" "$RST" "$VER" "$SIZE"

# ЭНДПОИНТ — /uploadStream, А НЕ /upload, и это не выбор, а необходимость:
# в nginx у админки описаны только `location ^~ /admin/api/upload/` (чанки,
# со слэшем) и `location = /admin/api/uploadStream` — а голый /upload nginx
# сам отправляет в 301 на вариант со слэшем, до бэкенда запрос не доходит.
# Ровно этим же путём грузит сборки админка (admin.js), то есть путь один
# и проверен ею ежедневно.
#
# updateLatest=0 ЗАШИТ — см. шапку.
#
# Ответ — NDJSON-поток событий по строке на файл; складываем в файл, а не в
# переменную: у сборки лаунчера тысячи файлов. Успех — событие
# {"type":"done","outPath":".../manifests/launcher/<версия>.json"}: сверяем и
# тип, и версию в пути, а не верим коду 200 — прокси, отдавший 200 с чужим
# телом, иначе сошёл бы за успех. Таймаут щедрый: ZIP под сотню мегабайт
# едет по обычному каналу, а после него сервер ещё распаковывает и хеширует.
EVENTS="$(mktemp -t dk-upload-XXXXXX)"
trap 'rm -f "$JAR" "$EVENTS"' EXIT
curl -fsSN --max-time 900 -b "$JAR_C" \
    -H 'Accept: application/x-ndjson' \
    -H "X-CSRF-Token: $CSRF" \
    -F "kind=launcher" \
    -F "gameId=launcher" \
    -F "version=$VER" \
    -F "updateLatest=0" \
    -F "zip=@$ZIP_C;type=application/zip" \
    "$URL/uploadStream" > "$EVENTS" \
    || die "админка не приняла сборку $VER (см. ответ сервера выше)"

# Ошибка приходит СОБЫТИЕМ в потоке при коде 200 — искать её надо в хвосте,
# а не в коде возврата curl.
if grep -q '"type":[[:space:]]*"error"' "$EVENTS"; then
    die "админка отвергла сборку $VER: $(grep '"type":[[:space:]]*"error"' "$EVENTS" | tail -1 | head -c 300)"
fi
DONE="$(grep '"type":[[:space:]]*"done"' "$EVENTS" | tail -1)"
case "$DONE" in
    *"/$VER.json"*) : ;;
    "") die "поток оборвался без события done — публикация не подтверждена. Хвост ответа: $(tail -c 300 "$EVENTS")" ;;
    *)  die "событие done указывает не на версию $VER: ${DONE:0:200}" ;;
esac

ok "сборка $VER на сервере: манифест manifests/launcher/$VER.json построен"
printf '%s→%s latest.json НЕ переключён: активной версию делает человек в админке\n' "$YEL" "$RST"
exit 0
