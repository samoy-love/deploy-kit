# Доступ к боевому серверу для локальной выкатки.
# Значения с пробелами обязательно в кавычках: файл читается как shell-скрипт.
DEPLOY_HOST=207.127.93.34
DEPLOY_USER=ubuntu
DEPLOY_KEY="~/.ssh/samoylove-deploy-key"

# Уведомления о выкатке в Telegram — те же токен и чат, что у пайплайна.
# Необязательны, но без них bin/deploy при каждой выкатке скажет в stderr, что
# уведомление отправить нечем: молчащее уведомление и выключенное уведомление
# должны выглядеть по-разному.
#
# Заданные, они уравнивают локальную выкатку с CI. Иначе сообщения в чате
# перестают быть летописью прода: «ничего не приходило» начинает означать
# «либо ничего не катилось, либо катилось руками», а это разные вещи.
#
# Чем шумит уведомление, управляет NOTIFY в описании цели: all (по умолчанию),
# fail — только о провале, never — молчать совсем (и не предупреждать о том,
# что чат не настроен). О провале не молчит и fail.
#
# Значения ниже — заглушки. Настоящий токен живёт только в этом файле у вас на
# машине и в секретах репозитория; в git он не попадает никогда.
#TELEGRAM_BOT_TOKEN=123456:AA...
#TELEGRAM_CHAT_ID=100000000
