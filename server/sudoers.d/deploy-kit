# Права выкатки для учётной записи, под которой ходит CI.
# Ставится как /etc/sudoers.d/deploy-kit, владелец root:root, режим 0440.
# Выкладывается `install-server --apply --with-sudoers`.
#
# ═══════════════════════════════════════════════════════════════════════════
# ЧИТАТЬ ДО ПРИМЕНЕНИЯ. Один этот файл ничего не сужает.
# ═══════════════════════════════════════════════════════════════════════════
#
# sudo разбирает /etc/sudoers.d в лексическом порядке и применяет ПОСЛЕДНЕЕ
# совпавшее правило. Сейчас на хосте лежит:
#
#     /etc/sudoers.d/90-cloud-init-users:  ubuntu ALL=(ALL) NOPASSWD:ALL
#
# Пока эта строка на месте, добавление файла ниже НЕ СУЖАЕТ НИЧЕГО: всё, что
# не перечислено здесь, по-прежнему разрешено предыдущим правилом. Узкий
# список начинает работать только после того, как широкое правило убрано.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ ПОЛЬЗОВАТЕЛЬ, А НЕ ubuntu. Сузить права самому ubuntu
# нельзя, не сломав администрирование: под ним же заходит человек, и под ним
# же работает install-server, которому нужны `install` и `bash -n` от root.
# Пока CI и человек — одна учётка с одним набором прав, «права выкатки»
# означают «права на всё»: утечка DEPLOY_SSH_KEY даёт не запуск релиза, а
# немедленный root.
#
# ПОРЯДОК МИГРАЦИИ (делается руками, по одному шагу, с открытой второй сессией
# на случай ошибки — восстановить sudo, потеряв его, можно только через
# консоль Oracle):
#
#   1. Завести пользователя:  sudo adduser --system --group --shell /bin/bash deploy
#   2. Положить ему ключ CI:  /home/deploy/.ssh/authorized_keys (0600, deploy:deploy)
#      и УБРАТЬ этот ключ из /home/ubuntu/.ssh/authorized_keys
#   3. Выложить этот файл:    install-server --apply --with-sudoers
#   4. Поменять секрет DEPLOY_USER в GitHub: ubuntu -> deploy
#   5. Прогнать выкатку с dry-run и убедиться, что она проходит
#   6. Только теперь: sudo visudo -f /etc/sudoers.d/90-cloud-init-users
#      и убрать строку про ubuntu, если административный доступ остаётся
#      по ключу человека с полными правами через отдельное правило
#
# Шаг 6 отделён намеренно: до него откат — это просто вернуть DEPLOY_USER.

# Пользователь CI. Имя должно совпадать с секретом DEPLOY_USER в репозиториях.
User_Alias  DEPLOY_USERS = deploy

# Ровно четыре скрипта, которые вызывают пайплайны (см. static-site.yml,
# go-service.yml) и локальная команда `dk`. Каталог прибит абсолютным путём:
# правило на относительный путь обходится подменой PATH.
Cmnd_Alias  DEPLOY_CMDS = /opt/deploy-kit/preflight.sh,   \
                          /opt/deploy-kit/release.sh,     \
                          /opt/deploy-kit/rollback.sh,    \
                          /opt/deploy-kit/nginx-apply.sh, \
                          /opt/deploy-kit/publish-file.sh

DEPLOY_USERS ALL=(root) NOPASSWD: DEPLOY_CMDS

# ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ.
#
# `install`, `cp`, `tee`, `systemctl` общего вида — каждая из этих команд от
# root эквивалентна root: `install` пишет любой файл куда угодно, `systemctl`
# запускает любой юнит. Их использует install-server, а его запускает человек
# своей учёткой, а не CI.
#
# Аргументы скриптов не ограничены, и это осознанно: перечислить допустимые
# --root и --app списком в sudoers невозможно без того, чтобы файл устаревал
# при каждом новом проекте. Проверку аргументов делают сами скрипты
# (preflight.sh сверяет каталог, release.sh — версионный шлюз), и это их
# работа, а не sudoers.
